---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import ChatWidget from "../components/ChatWidget.astro";
import { PUBLIC_GOOGLE_SITE_VERIFICATION, PUBLIC_GA4_MEASUREMENT_ID } from "astro:env/client";
import { SITE } from "@/config";
import "@/styles/global.css";

type Props = {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  /**
   * Set true on paginated archive pages (/posts/2/, /posts/3/...) and any
   * other URL that should stay crawlable but not show in search results.
   * GSC was showing 1-impression-zero-click hits for /posts/102/ etc.
   * eating crawl budget.
   */
  noindex?: boolean;
};

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.url),
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  noindex = false,
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.url);

// Use BlogPosting schema only when this is an actual post (has a publish date).
// For collection / index / utility pages (home, /brands, /tags, /about, /search,
// paginated /posts/N) emit WebSite/CollectionPage instead so we never ship
// invalid `datePublished: "undefined"` to Google.
const structuredData = pubDatetime
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: `${title}`,
      image: `${socialImageURL}`,
      datePublished: pubDatetime.toISOString(),
      ...(modDatetime && { dateModified: modDatetime.toISOString() }),
      author: [
        {
          "@type": "Person",
          name: `${author}`,
          ...(profile && { url: profile }),
        },
      ],
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      url: SITE.website,
      name: SITE.title,
      description: SITE.desc,
      publisher: {
        "@type": "Organization",
        name: SITE.title,
        url: SITE.website,
      },
    };
---

<!doctype html>
<html
  dir={SITE.dir}
  lang=`${SITE.lang ?? "en"}`
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta name="impact-site-verification" {...({'value': '367ef661-eac1-4210-8938-1c5b85b6539c'} as any)} />

    <!-- Connection pre-warming for the third-party origins we always hit -->
    <link rel="dns-prefetch" href="https://errorcodefixes-chat.errorcodefixes.workers.dev" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Load Font -->
    <Font
      cssVariable="--font-google-sans-code"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />

    <meta name="theme-color" content="#d97706" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    <!-- Google Analytics 4 — lazy-loaded after first idle so it doesn't
         block LCP. Activate by setting PUBLIC_GA4_MEASUREMENT_ID env var. -->
    {
      PUBLIC_GA4_MEASUREMENT_ID && (
        <script is:inline define:vars={{ gaId: PUBLIC_GA4_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', gaId, { send_page_view: false });
          // Defer the heavy gtag.js fetch until the browser is idle (or 4s
          // fallback so analytics still fires on long-paint pages).
          var loadGa = function () {
            if (window._gaLoaded) return;
            window._gaLoaded = true;
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
            s.onload = function () { gtag('event', 'page_view'); };
            document.head.appendChild(s);
          };
          if ('requestIdleCallback' in window) {
            requestIdleCallback(loadGa, { timeout: 4000 });
          } else {
            setTimeout(loadGa, 2000);
          }
          // View-transitions: fire page_view after Astro swap.
          document.addEventListener('astro:page-load', function () {
            if (window._gaLoaded && typeof gtag === 'function') {
              gtag('event', 'page_view');
            }
          });
        </script>
      )
    }

    <ClientRouter />

    <!-- Minimal inline script to prevent FOUC - sets theme immediately -->
    <script is:inline>
      (function () {
        const initialColorScheme = "light"; // "light" | "dark"
        const currentTheme = localStorage.getItem("theme");

        function getPreferTheme() {
          if (currentTheme) return currentTheme;
          if (initialColorScheme) return initialColorScheme;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        const themeValue = getPreferTheme();

        // Set theme immediately to prevent flash
        document.firstElementChild?.setAttribute("data-theme", themeValue);

        // Export minimal API for external script
        window.theme = {
          themeValue: themeValue,
          getTheme: () => window.theme.themeValue,
          setTheme: val => {
            window.theme.themeValue = val;
          },
        };
      })();
    </script>

    <!--
      Skimlinks auto-monetization. Approved 2026-05-21. Publisher 303448X1791493.
      Rewrites outbound merchant links across the catalog (Parts Town, RepairClinic,
      Home Depot, AutomationDirect, Galco, etc.) without per-merchant signup.
      TODO 2026-05-22: once Skimlinks moves from "pending approval" to active,
      add amazon.com / amzn.to / amazon.co.uk to Excluded Domains in the
      dashboard (Toolbox unlocked then) so direct Amazon Associates
      (tag=errorcodefixes-20) stays 100% commission.
    -->
    <script type="text/javascript" src="https://s.skimresources.com/js/303448X1791493.skimlinks.js" is:inline></script>
  </head>
  <body>
    <slot />

    <!-- Load full theme logic -->
    <script src="../scripts/theme.ts"></script>

    <!-- GA4 Key Event tracking -->
    <script src="../scripts/analytics.ts"></script>

    <!--
      Awin MasterTag — publisher 2905561. Tracks affiliate clicks for the 10
      advertisers applied to on 2026-05-21 (Tado DE/UK/NL-BE, GE Appliances Parts,
      Filter King, National Filter Warehouse, Ebac, Castle Heaters, Hüga Heat,
      Shop Appliances, Heizungsdiscount24 DE). Required for commission tracking
      once any advertiser approves. Placed at end of body with defer per Awin's
      MasterTag 2.0 installation guide.
    -->
    <script defer src="https://www.dwin1.com/2905561.js" type="text/javascript" is:inline></script>

    <!-- AI Chat Widget -->
    <ChatWidget />
  </body>
</html>
