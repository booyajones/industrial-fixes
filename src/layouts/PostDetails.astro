---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import ContractorCTA from "../components/ContractorCTA.astro";
import { SITE } from "@/config";
import BackToTopButton from "@/components/BackToTopButton.astro";
import QuickAnswer from "@/components/QuickAnswer.astro";
import AtAGlance from "@/components/AtAGlance.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import EmailCapture from "../components/EmailCapture.astro";
import AffiliateDisclosure from "@/components/AffiliateDisclosure.astro";
import PartsSpecialist from "@/components/PartsSpecialist.astro";
import StickyPartsBar from "@/components/StickyPartsBar.astro";
import PartCallout from "@/components/PartCallout.astro";
import NoBuyVerdict from "@/components/NoBuyVerdict.astro";
import { getPath } from "@/utils/getPath";
import { authors } from "../data/authors";
import { equipmentCategories } from "@/data/equipmentCategories";
import { slugifyStr } from "@/utils/slugify";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
  hideEditPost,
  most_likely_cause,
  likelihood,
  diy_or_pro,
  money_part,
  free_checks,
  part_price,
  no_buy_pct,
} = post.data;

const { Content } = await render(post);

const authorData = authors[author];

// Internal linking / topical authority: link this guide to its brand hub
// (/brands/<brand>/) so readers can browse every code for the same brand.
// Raises sessions-per-visit (more affiliate impressions) and topical signal.
// Only the brands that actually have a hub page qualify; derive from the
// FIRST tag that matches one of those hubs, case-insensitively.
const BRAND_HUBS: Record<string, string> = {
  // Consumer appliance brands. Each has a /brands/<slug>/ hub built by
  // src/pages/brands/[brand].astro. These are the money pages, so the brand-hub
  // link is what drives topical authority + sessions per visit on consumer traffic.
  "samsung": "Samsung",
  "lg": "LG",
  "whirlpool": "Whirlpool",
  "ge": "GE",
  "frigidaire": "Frigidaire",
  "maytag": "Maytag",
  "bosch": "Bosch",
  "kitchenaid": "KitchenAid",
  "kenmore": "Kenmore",
  "electrolux": "Electrolux",
  "amana": "Amana",
  "navien": "Navien",
  "rinnai": "Rinnai",
  // HVAC / legacy brands (hubs also exist):
  "carrier": "Carrier",
  "goodman": "Goodman",
  "lennox": "Lennox",
  "trane": "Trane",
  "rheem": "Rheem",
  "york": "York",
  "daikin": "Daikin",
  "mitsubishi": "Mitsubishi",
  "fujitsu": "Fujitsu",
  "hoshizaki": "Hoshizaki",
  "manitowoc": "Manitowoc",
  "fanuc": "Fanuc",
  "haas": "Haas",
  "yaskawa": "Yaskawa",
  "abb": "ABB",
  "siemens": "Siemens",
  "allen-bradley": "Allen-Bradley",
  "danfoss": "Danfoss",
};
const hubMatch = (tags ?? [])
  .map(t => t.toLowerCase())
  .find(t => t in BRAND_HUBS);
const brandHub = hubMatch
  ? { slug: hubMatch, name: BRAND_HUBS[hubMatch] }
  : null;

// The merchant search query for the parts CTAs (sticky bar + parts specialist).
// RepairClinic/PartSelect search needs a PART query ("Samsung dishwasher drain
// pump assembly"), never the page title ("... 3C Error Code - Causes & Fix"),
// which returns zero results and burns the click. Priority: the page's #1
// buyable part -> "brand appliance parts" -> de-suffixed title as last resort.
const _APPL_TAGS = ["washer", "dryer", "refrigerator", "dishwasher", "range", "oven",
  "microwave", "cooktop", "freezer", "furnace", "water-heater", "mini-split", "heat-pump"];
const _equipTag = (tags ?? []).map(t => t.toLowerCase()).find(t => _APPL_TAGS.includes(t));
const _brandEquip = [brandHub?.name ?? "", _equipTag?.replace(/-/g, " ") ?? ""]
  .filter(Boolean).join(" ").trim();
const partsQuery = (money_part && money_part.trim())
  || (_brandEquip ? `${_brandEquip} parts` : "")
  || title.replace(/\s+[-—–].*$/, "").trim();

// Map this post's tags to an equipment category so EmailCapture can deliver
// the right cheat-sheet PDF. Returns undefined if no overlap.
const tagSet = new Set((tags ?? []).map(t => t.toLowerCase()));
const postCategory = equipmentCategories.find(c =>
  c.tags.some(t => tagSet.has(t))
)?.slug;

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

// Reading time estimate — 230 wpm is the standard for technical
// non-fiction. Word count comes from the post body (not frontmatter).
const wordCount = (post.body || "").trim().split(/\s+/).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 230));

// "Last reviewed" relative phrasing for the trust bar. Shows "today",
// "2 weeks ago", "3 months ago" instead of bare date — humans parse
// recency faster than they parse a Y/M/D.
const reviewDate = modDatetime || pubDatetime;
const daysAgo = Math.floor((Date.now() - reviewDate.getTime()) / (24 * 3600 * 1000));
let reviewedLabel: string;
if (daysAgo <= 0) reviewedLabel = "today";
else if (daysAgo === 1) reviewedLabel = "yesterday";
else if (daysAgo < 14) reviewedLabel = `${daysAgo} days ago`;
else if (daysAgo < 60) reviewedLabel = `${Math.floor(daysAgo / 7)} weeks ago`;
else if (daysAgo < 730) reviewedLabel = `${Math.floor(daysAgo / 30)} months ago`;
else reviewedLabel = `${Math.floor(daysAgo / 365)} years ago`;

// Error-code hero: the council's "make the code the hero" trust cue. Pull the
// token that precedes "error code" / "fault code" in the title, and only show it
// when it looks like a real code (has a digit, or is 1-3 uppercase letters), so
// parts / symptom / model pages render no chip.
const _heroMatch = title.match(/\b([A-Za-z0-9]{1,6})\s+(?:error|fault)\s+code\b/i);
const _heroTok = _heroMatch?.[1];
const heroCode = _heroTok && (/\d/.test(_heroTok) || /^[A-Z]{1,3}$/.test(_heroTok)) ? _heroTok : null;

const layoutProps = {
  title: `${title} | errorcodefixes.com`,
  author: authorData?.name ?? "Error Code Fixes Editorial Team",
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
};

/* ========== Prev/Next Posts ========== */

const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath,
}));

const currentPostIndex = allPosts.findIndex(a => a.id === post.id);

const prevPost = currentPostIndex !== 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex !== allPosts.length ? allPosts[currentPostIndex + 1] : null;
---

<Layout {...layoutProps}>

  <!-- HowTo schema removed: Google retired HowTo rich results in Sept 2023, and
       identical templated steps across 1,400+ pages read as scaled markup. The
       page is described by BlogPosting (Layout.astro) + the FAQ + breadcrumb below. -->

  <!-- BreadcrumbList JSON-LD — Home > Posts > Category > Title.
       Lets Google render breadcrumb chips under the SERP listing instead of
       the raw URL, lifting CTR a few percentage points. -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.website.replace(/\/+$/, "") + "/" },
      { "@type": "ListItem", "position": 2, "name": "Fix Guides", "item": SITE.website.replace(/\/+$/, "") + "/posts/" },
      ...(postCategory ? [{ "@type": "ListItem", "position": 3, "name": equipmentCategories.find(c => c.slug === postCategory)?.name ?? postCategory, "item": SITE.website.replace(/\/+$/, "") + `/equipment/${postCategory}/` }] : []),
      { "@type": "ListItem", "position": postCategory ? 4 : 3, "name": title.replace(/—.*$/, '').trim(), "item": SITE.website.replace(/\/+$/, "") + Astro.url.pathname }
    ]
  })} />

  <!-- FAQ Schema for Google Rich Results — brand/code-aware, content-derived.
       Drives People Also Ask placements. Five questions a tech actually asks. -->
  {(() => {
    const cleanTitle = title.replace(/—.*$/, '').trim();
    const brandName = brandHub?.name; // real brand (e.g. "Samsung"), or undefined for generic/HVAC
    // Extract the error code token if title looks like "Brand 12 — ..." or "Brand Error Code 12"
    const codeMatch = cleanTitle.match(/\b([A-Z]{1,3}\s?\d{1,4}|\d{1,4}|E\d+|F\d+|P\d+|H\d+|L\d+)\b/);
    const code = codeMatch?.[1];
    // Answers grounded in THIS page's real data (cause/part/price/diy) — specific
    // answers are far stronger AI-citation bait than templated boilerplate.
    const _cause = most_likely_cause ? most_likely_cause.replace(/\.$/, "").toLowerCase() : "";
    const faqs = [
      { q: `What does ${cleanTitle} mean?`, a: description },
      { q: `How do I fix ${cleanTitle}?`, a: `${_cause ? `Start with the most common cause: ${_cause}. ` : `Start with a power-cycle reset and the most common cause. `}Work through the step-by-step diagnosis in this guide${money_part ? `, and replace the ${money_part.toLowerCase()} only if the checks confirm it has failed.` : `, and confirm the faulty part before replacing anything.`} Most fixes need basic hand tools and the right part.` },
      { q: `Can I keep running my ${brandName ? brandName + ' ' : ''}equipment with ${code ?? 'this error'} showing?`, a: `Usually not. This error means a part or safety circuit is out of range, so continuing to run it can make the fault worse. Diagnose and clear ${code ?? 'the error'} before returning to normal use.` },
      { q: `What part is most commonly replaced for ${cleanTitle}?`, a: money_part ? `The ${money_part} is the part that most often resolves ${cleanTitle}${part_price ? ` (typically ${part_price})` : ""}. Match it to your exact model and serial number before ordering, and confirm with the diagnostic checks first.` : `Match the most likely part to your exact model and serial number before ordering; rule out the free checks in this guide first.` },
      { q: `Is ${cleanTitle} a DIY repair or do I need a technician?`, a: diy_or_pro === "pro" ? `This one should go to a qualified technician — it typically involves sealed-system, refrigerant, high-voltage, or precision work that needs proper tools and training.` : diy_or_pro === "diy" ? `This is usually a DIY-friendly repair with basic hand tools and the right replacement part. Sealed-system, refrigerant, gas, or high-voltage work should still go to a licensed technician.` : `Many of these fixes are DIY-friendly with basic tools, but sealed-system, refrigerant, gas, or high-voltage work should go to a licensed technician for safety.` }
    ];
    return (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
      })} />
    );
  })()}
  <Header />
  <BackButton />
  <main
    id="main-content"
    class:list={["app-layout pb-12", { "mt-8": !SITE.showBackButton }]}
    data-pagefind-body
  >
    {heroCode && (
      <div class="code-hero">
        <span class="code-hero-label">Error code</span>
        <span class="code-hero-value">{heroCode}</span>
      </div>
    )}
    <div class="title-copy-wrapper">
      <h1
        transition:name={slugifyStr(title.replaceAll(".", "-"))}
        class="inline-block text-2xl font-bold text-foreground sm:text-3xl"
      >
        {title}
      </h1>
      <button class="copy-code-btn" data-pagefind-ignore data-title={title} aria-label="Copy error code name">
        Copy
      </button>
    </div>
    <div class="article-meta" data-pagefind-ignore>
      <span class="article-author">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
        </svg>
        {
          authorData && authorData.slug ? (
            <>
              <a href={`/authors/${authorData.slug}/`}>{authorData.name}</a>
              {authorData.credentials && <span>, {authorData.credentials}</span>}
            </>
          ) : authorData ? (
            <span>{authorData.name}{authorData.credentials ? `, ${authorData.credentials}` : ''}</span>
          ) : (
            <span>Error Code Fixes Editorial Team</span>
          )
        }
      </span>
      <span class="article-date">
        Reviewed <time datetime={reviewDate.toISOString()} title={reviewDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}>
          {reviewedLabel}
        </time>
      </span>
      <span class="article-read-time">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        {readingMinutes} min read
      </span>
    </div>
    <p class="independent-note" data-pagefind-ignore>
      Independent. We don't sell parts, so we tell you when not to buy one.
    </p>

    <!-- Quick Answer Box. Rendered FIRST (right after the meta row) so its <p>
         is the LCP element and paints near the top of the mobile viewport — it
         was the article LCP element and sat below the fold when AtAGlance came
         before it (LCP ~3.5s). Answer-first is also the better reading order. -->
    <QuickAnswer {description} {title} hasPart={!!money_part} />

    <!-- Verdict block: a technician's most-likely-cause call + a color-coded
         DIY/Pro badge. Renders only when there is NO money_part — when a part
         exists, the NoBuyVerdict below carries the cause + badge, so this would
         be redundant (the cause appearing twice back-to-back). -->
    {!money_part && (most_likely_cause || diy_or_pro) && (
      <div class="verdict" data-pagefind-ignore>
        {most_likely_cause && (
          <p class="verdict-cause">
            <span class="verdict-label">Most likely</span>
            {most_likely_cause}{likelihood ? ` (${likelihood})` : ""}
          </p>
        )}
        {diy_or_pro && (
          <span class={`verdict-badge verdict-${diy_or_pro}`}>
            {diy_or_pro === "pro" ? "Pro repair" : "DIY-friendly"}
          </span>
        )}
      </div>
    )}

    <!-- No-buy verdict: the cost-fork judgment call (lead with "don't buy yet").
         Above the fold; the buy button (PartCallout) now sits BELOW the free-fix
         gate, anchored at #get-the-part. This is the AI-Overview hedge + the
         honesty moat + a buyer pre-qualifier (DO-NOW #2, the biggest lever). -->
    {money_part && (
      <NoBuyVerdict
        cause={most_likely_cause}
        part={money_part}
        partPrice={part_price}
        noBuyPct={no_buy_pct}
        freeChecks={free_checks}
        pro={diy_or_pro === "pro"}
        diyOrPro={diy_or_pro}
        code={heroCode ?? undefined}
      />
    )}

    <!-- Internal link to the brand hub for topical authority + more sessions
         per visit. Subtle, single inline link; only rendered when the post's
         tags include a brand that has a hub page. data-internal-link tags it
         for later GA4 / log analysis. Placed right under the Quick Answer so
         it never crowds out the answer itself. -->
    {brandHub && (
      <p class="brand-hub-link">
        <a href={`/brands/${brandHub.slug}/`} data-internal-link="brand-hub">
          See all {brandHub.name} error codes →
        </a>
      </p>
    )}

    <!-- At-a-glance triage strip: difficulty / time / tools, inferred from tags.
         After the Quick Answer — a tech triages once they've read the summary. -->
    <AtAGlance {tags} />

    <!-- Inline email capture immediately after the Quick Answer. This is
         where intent peaks — the user just read the fix summary. Bottom-
         of-article placement after the Angi banner was where email signup
         went to die. (Bottom EmailCapture is still rendered below as a
         second touchpoint for users who scroll the whole guide.) -->
    <EmailCapture brand={tags?.[0]} category={postCategory} />

    <!-- FTC affiliate disclosure: clear, conspicuous, above the parts tables -->
    <AffiliateDisclosure />

    <article
      id="article"
      class="app-prose mt-8 w-full max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    >
      <Content />
    </article>

    <!-- The buy button, now BELOW the free-fix gate. By the time the reader is
         here they have passed the no-buy verdict + the diagnostic + the fix
         steps, so this click is pre-qualified (they need the part) and converts
         harder. #get-the-part is the anchor the no-buy verdict's "already ruled
         those out?" link jumps to. -->
    {money_part && (
      <div id="get-the-part">
        <PartCallout part={money_part} query={partsQuery} price={part_price} brand={tags?.[0] ?? ""} tags={tags} pro={diy_or_pro === "pro"} />
      </div>
    )}

    <!-- "Shop the replacement part": the reader has just diagnosed the fault,
         so buying intent peaks here. Routes to a category-appropriate parts
         specialist; links are Skimlinks-monetized (no noskim). Placed after
         the article body and before the tag/EditPost block. -->
    <PartsSpecialist {tags} query={partsQuery} />

    <!-- Sticky mobile "get the part" bar: appears after the reader scrolls into
         the fix, so the affiliate click is earned. Mobile only, self-contained. -->
    <StickyPartsBar query={partsQuery} part={money_part} brand={tags?.[0] ?? ''} tags={tags} />

    <hr class="my-8 border-dashed" />

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>

    <BackToTopButton />

    <RelatedPosts currentSlug={post.id} {tags} {posts} />

    {tags && (tags.includes('hvac') || tags.includes('furnace') || tags.includes('heat-pump') || tags.includes('boiler') || tags.includes('mini-split') || tags.includes('vfd') || tags.includes('refrigeration') || tags.includes('commercial-refrigeration')) && <ContractorCTA equipment="HVAC" />}

    <EmailCapture brand={tags?.[0]} category={postCategory} />

    <ShareLinks />
    <button onclick="window.print()" class="print-btn" aria-label="Print guide">
      🖨️ Print guide
    </button>

    <hr class="my-6 border-dashed" />

    <!-- Previous/Next Post Buttons -->
    <div data-pagefind-ignore class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        prevPost && (
          <a
            href={getPath(prevPost.id, prevPost.filePath)}
            class="flex w-full gap-1 hover:opacity-75"
          >
            <IconChevronLeft class="inline-block flex-none rtl:rotate-180" />
            <div>
              <span>Previous Post</span>
              <div class="text-sm font-medium text-foreground">{prevPost.title}</div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={getPath(nextPost.id, nextPost.filePath)}
            class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
          >
            <div>
              <span>Next Post</span>
              <div class="text-sm font-medium text-foreground">{nextPost.title}</div>
            </div>
            <IconChevronRight class="inline-block flex-none rtl:rotate-180" />
          </a>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .article-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    font-size: 0.8rem;
    color: #4b5563;
    margin-bottom: 1rem;
  }
  .article-author {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: #166534;
    font-weight: 500;
  }
  .article-date { color: #4b5563; }
  .article-read-time {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: #4b5563;
  }

  /* Subtle inline internal link to the brand hub. #166534 on the white/light
     page background is ~6.7:1 contrast (passes AA). Sits just under the Quick
     Answer without competing with the answer copy. */
  .brand-hub-link {
    margin: -0.5rem 0 1.5rem 0;
    font-size: 0.85rem;
  }
  .brand-hub-link a {
    color: #166534;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid rgba(22, 101, 52, 0.35);
  }
  .brand-hub-link a:hover,
  .brand-hub-link a:focus-visible {
    border-bottom-color: #166534;
  }

  /* Error-code hero: the actual code in monospace on a service-blue chip, so a
     panicked reader confirms they are on the right page in under a second. */
  .code-hero {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.7rem;
    padding: 0.3rem 0.75rem 0.4rem;
    background: var(--code-bg);
    border-radius: 7px;
  }
  .code-hero-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--code-fg) 68%, transparent);
  }
  .code-hero-value {
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1;
    color: var(--code-fg);
    letter-spacing: 0.02em;
  }
  /* Honest positioning made a feature (the council's highest-trust line). */
  .independent-note {
    margin: 0 0 1.1rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--brand);
    border-left: 3px solid var(--brand);
    padding-left: 0.6rem;
  }
  /* Verdict block: a most-likely-cause call + a color-coded DIY/Pro badge,
     right under the Quick Answer. The whole "diagnosis at a glance" cue. */
  .verdict {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem 0.9rem;
    margin: 0 0 1.25rem;
  }
  .verdict-cause {
    margin: 0;
    font-size: 0.95rem;
    color: var(--foreground);
  }
  .verdict-label {
    display: inline-block;
    margin-right: 0.4rem;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--foreground) 58%, transparent);
  }
  .verdict-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.22rem 0.65rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .verdict-diy {
    color: var(--safe);
    background: color-mix(in srgb, var(--safe) 16%, transparent);
  }
  .verdict-pro {
    color: var(--danger);
    background: color-mix(in srgb, var(--danger) 16%, transparent);
  }

  /* Title + copy button */
  .title-copy-wrapper {
    display: flex;
    align-items: flex-start;
