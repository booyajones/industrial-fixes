---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import EditPost from "@/components/EditPost.astro";
import { SITE } from "@/config";
import BackToTopButton from "@/components/BackToTopButton.astro";
import DiagnosisCard from "@/components/DiagnosisCard.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import EmailCapture from "../components/EmailCapture.astro";
import AffiliateDisclosure from "@/components/AffiliateDisclosure.astro";
import StickyPartsBar from "@/components/StickyPartsBar.astro";
import PartCallout from "@/components/PartCallout.astro";
import QuoteRequest from "@/components/QuoteRequest.astro";
import { getPath } from "@/utils/getPath";
import getListablePosts from "@/utils/getListablePosts";
import { authors } from "../data/authors";
import { equipmentCategories } from "@/data/equipmentCategories";
import { NOINDEX_SLUGS } from "@/data/noindex-slugs";
import { slugifyStr } from "@/utils/slugify";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import frStats from "@/data/field-reference-stats.json";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
  hideEditPost,
  most_likely_cause,
  diy_or_pro,
  money_part,
  free_checks,
  part_price,
} = post.data;

const { Content } = await render(post);

const authorData = authors[author];

// Internal linking / topical authority: the visible breadcrumb (and its
// matching BreadcrumbList JSON-LD) links this guide to its brand hub
// (/brands/<brand>/) so readers can browse every code for the same brand.
// Only the brands that actually have a hub page qualify; derive from the
// FIRST tag that matches one of those hubs, case-insensitively.
const BRAND_HUBS: Record<string, string> = {
  // Consumer appliance brands. Each has a /brands/<slug>/ hub built by
  // src/pages/brands/[brand].astro. These are the money pages, so the brand-hub
  // link is what drives topical authority + sessions per visit on consumer traffic.
  "samsung": "Samsung",
  "lg": "LG",
  "whirlpool": "Whirlpool",
  "ge": "GE",
  "frigidaire": "Frigidaire",
  "maytag": "Maytag",
  "bosch": "Bosch",
  "kitchenaid": "KitchenAid",
  "kenmore": "Kenmore",
  "electrolux": "Electrolux",
  "amana": "Amana",
  "navien": "Navien",
  "rinnai": "Rinnai",
  // HVAC / legacy brands (hubs also exist):
  "carrier": "Carrier",
  "goodman": "Goodman",
  "lennox": "Lennox",
  "trane": "Trane",
  "rheem": "Rheem",
  "york": "York",
  "daikin": "Daikin",
  "mitsubishi": "Mitsubishi",
  "fujitsu": "Fujitsu",
  "hoshizaki": "Hoshizaki",
  "manitowoc": "Manitowoc",
  "fanuc": "Fanuc",
  "haas": "Haas",
  "yaskawa": "Yaskawa",
  "abb": "ABB",
  "siemens": "Siemens",
  "allen-bradley": "Allen-Bradley",
  "danfoss": "Danfoss",
  // Industrial brands with proven engaged human traffic (added 2026-07):
  "sew-eurodrive": "SEW-Eurodrive",
  "apc": "APC",
  "rational": "Rational",
};
const hubMatch = (tags ?? [])
  .map(t => t.toLowerCase())
  .find(t => t in BRAND_HUBS);
const brandHub = hubMatch
  ? { slug: hubMatch, name: BRAND_HUBS[hubMatch] }
  : null;

// The merchant search query for the parts CTAs (sticky bar + parts module).
// RepairClinic/PartSelect search needs a PART query ("Samsung dishwasher drain
// pump assembly"), never the page title ("... 3C Error Code - Causes & Fix"),
// which returns zero results and burns the click. Priority: the page's #1
// buyable part -> "brand appliance parts" -> de-suffixed title as last resort.
const _APPL_TAGS = ["washer", "dryer", "refrigerator", "dishwasher", "range", "oven",
  "microwave", "cooktop", "freezer", "furnace", "water-heater", "mini-split", "heat-pump"];
const _equipTag = (tags ?? []).map(t => t.toLowerCase()).find(t => _APPL_TAGS.includes(t));
const _brandEquip = [brandHub?.name ?? "", _equipTag?.replace(/-/g, " ") ?? ""]
  .filter(Boolean).join(" ").trim();
const partsQuery = (money_part && money_part.trim())
  || (_brandEquip ? `${_brandEquip} parts` : "")
  || title.replace(/\s+[-—–].*$/, "").trim();

// Map this post's tags to an equipment category so EmailCapture can deliver
// the right cheat-sheet PDF. Returns undefined if no overlap.
const tagSet = new Set((tags ?? []).map(t => t.toLowerCase()));
const postCategory = equipmentCategories.find(c =>
  c.tags.some(t => tagSet.has(t))
)?.slug;

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

// Reading time estimate — 230 wpm is the standard for technical
// non-fiction. Word count comes from the post body (not frontmatter).
const wordCount = (post.body || "").trim().split(/\s+/).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 230));

// "Updated" relative phrasing for the trust bar. Shows "today",
// "2 weeks ago", "3 months ago" instead of bare date — humans parse
// recency faster than they parse a Y/M/D.
const reviewDate = modDatetime || pubDatetime;
const daysAgo = Math.floor((Date.now() - reviewDate.getTime()) / (24 * 3600 * 1000));
let reviewedLabel: string;
if (daysAgo <= 0) reviewedLabel = "today";
else if (daysAgo === 1) reviewedLabel = "yesterday";
else if (daysAgo < 14) reviewedLabel = `${daysAgo} days ago`;
else if (daysAgo < 60) reviewedLabel = `${Math.floor(daysAgo / 7)} weeks ago`;
else if (daysAgo < 730) reviewedLabel = `${Math.floor(daysAgo / 30)} months ago`;
else reviewedLabel = `${Math.floor(daysAgo / 365)} years ago`;

// Error-code hero: the council's "make the code the hero" trust cue. Extract
// the code token from the title, and only show it when it looks like a real
// code (digit sanity check), so parts / symptom / model pages render no chip.
// Four title forms, most specific first:
//   1. "<TOK> error code" / "<TOK> fault code"     (consumer + many industrial)
//   2. "Alarm 10" / "Fault 3130" / "Error 21"      (industrial keyword-first)
//   3. "F0001 Fault" / "A0021 Alarm"               (industrial token-first)
//   4. "3 flashes"                                 (blink-code furnaces/heaters)
let heroCode: string | null = null;
{
  const m1 = title.match(/\b([A-Za-z0-9]{1,6})\s+(?:error|fault)\s+code\b/i);
  const t1 = m1?.[1];
  if (t1 && (/\d/.test(t1) || /^[A-Z]{1,3}$/.test(t1))) heroCode = t1;
}
if (!heroCode) {
  const m2 = title.match(/\b(alarm|fault|error|code)\s+#?([A-Z]{0,3}-?\d{1,5}(?:[.-]\d{1,4})?)\b/i);
  if (m2 && /\d/.test(m2[2])) {
    // "Code F0001" reads better as just "F0001"; bare numbers keep the keyword
    // ("Alarm 10") because "10" alone is ambiguous.
    heroCode = m2[1].toLowerCase() === "code"
      ? m2[2].toUpperCase()
      : `${m2[1][0].toUpperCase()}${m2[1].slice(1).toLowerCase()} ${m2[2].toUpperCase()}`;
  }
}
if (!heroCode) {
  // Negative lookahead: "<MODEL> Fault Codes" list pages ("ABB ACS880 Fault
  // Codes: ...") must NOT chip the model number as if it were a code.
  const m3 = title.match(/\b([A-Z]{1,3}\d{1,5}(?:[.-]\d{1,4})?)\s+(?:fault|alarm|error)\b(?!\s*codes?\b)/i);
  if (m3 && /\d/.test(m3[1])) heroCode = m3[1].toUpperCase();
}
if (!heroCode) {
  const m4 = title.match(/\b(\d{1,2})\s+flashes\b/i);
  if (m4) heroCode = `${m4[1]} flashes`;
}

// "Disconnect the motor" test: a real, standard VFD diagnostic that ONLY applies
// to OUTPUT-side faults (overcurrent / short / ground / output phase / IGBT) — it
// is wrong for input/control faults (undervoltage, comms, overtemp), so it is
// gated tightly to drive pages whose fault is clearly output-side. This is the
// exact long-tail competitors (Industrial Monitor Direct) rank for, and it is a
// verifiable technique, not fabricated code data.
const _isDrivePage = (tags ?? []).some(t =>
  ["vfd", "drive", "inverter", "servo", "industrial-controls", "ac-drive"].includes(t.toLowerCase()));
const _outputFault = /overcurrent|over current|short[\s-]?circuit|ground fault|earth fault|output phase|\bigbt\b|output stage/i
  .test(`${title} ${most_likely_cause ?? ""}`);
const showNoLoadTest = _isDrivePage && _outputFault;

// Quality-consolidation: zero-demand programmatic pages are noindexed so
// Google/AdSense evaluate the ~1,185-page quality core, not a 5,680-page farm.
const isNoindexed = NOINDEX_SLUGS.has(post.id);

const layoutProps = {
  title: `${title} | errorcodefixes.com`,
  author: authorData?.name ?? "Error Code Fixes Editorial Team",
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
  noindex: isNoindexed,
};

// Industrial lead capture (QuoteRequest) renders only on the segments with
// real human traffic and real dispatch value. Tag vocabulary verified against
// src/data/blog frontmatter 2026-07-27.
const QUOTE_TAGS = new Set([
  "industrial", "vfd", "cnc", "plc", "servo", "chiller", "ups",
  "generator", "ice-machine", "commercial-kitchen",
]);
const showQuoteRequest = (tags ?? []).some(t => QUOTE_TAGS.has(t.toLowerCase()));

/* ========== Prev/Next Posts ========== */

// Core (listable) pages must not link into the noindexed farm — computing
// prev/next from the full set sent ~75% of core prev/next clicks to noindexed
// pages. Use the listable set when the CURRENT post is listable; keep the
// full-set fallback only when the current post is itself noindexed (the
// documented exception in src/utils/getListablePosts.ts — a noindexed page
// can't resolve its neighbours in a set it isn't part of).
const navPool = isNoindexed ? posts : getListablePosts(posts);

const allPosts = navPool.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath,
}));

const currentPostIndex = allPosts.findIndex(a => a.id === post.id);

const prevPost = currentPostIndex > 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex !== -1 && currentPostIndex < allPosts.length - 1
    ? allPosts[currentPostIndex + 1]
    : null;
---

<Layout {...layoutProps}>

  <!-- HowTo schema removed: Google retired HowTo rich results in Sept 2023, and
       identical templated steps across 1,400+ pages read as scaled markup. The
       page is described by BlogPosting (Layout.astro) + the FAQ + breadcrumb below. -->

  <!-- BreadcrumbList JSON-LD — matches the VISIBLE breadcrumb below the header:
       Home > {brand hub | All guides} > Title. Lets Google render breadcrumb
       chips under the SERP listing instead of the raw URL. -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.website.replace(/\/+$/, "") + "/" },
      brandHub
        ? { "@type": "ListItem", "position": 2, "name": brandHub.name, "item": SITE.website.replace(/\/+$/, "") + `/brands/${brandHub.slug}/` }
        : { "@type": "ListItem", "position": 2, "name": "All guides", "item": SITE.website.replace(/\/+$/, "") + "/posts/" },
      { "@type": "ListItem", "position": 3, "name": title.replace(/—.*$/, '').trim(), "item": SITE.website.replace(/\/+$/, "") + Astro.url.pathname }
    ]
  })} />

  <!-- FAQ Schema — only the two Q&As whose answers correspond to visible page
       content ("What this code means" + the step-by-step fix). The other three
       templated Q&As had NO visible counterpart on the page (invisible marked-up
       answers = scaled-markup tell) and were cut 2026-07. -->
  {(() => {
    const cleanTitle = title.replace(/—.*$/, '').trim();
    const _cause = most_likely_cause ? most_likely_cause.replace(/\.$/, "").toLowerCase() : "";
    // Q1's answer is the description ONLY when it isn't generator boilerplate
    // ("What X means, why it happens...") — boilerplate restates the question
    // and is no longer rendered on the page. Fall back to the visible
    // most-likely-cause line; drop Q1 entirely when neither exists.
    const _boiler = /^What .{0,80} means, why it/i;
    const a1 = description && !_boiler.test(description)
      ? description
      : _cause
        ? `The most likely cause is ${_cause}. Work through the checks in this guide to confirm it before replacing anything.`
        : null;
    const faqs = [
      ...(a1 ? [{ q: `What does ${cleanTitle} mean?`, a: a1 }] : []),
      { q: `How do I fix ${cleanTitle}?`, a: `${_cause ? `Start with the most common cause: ${_cause}. ` : `Start with a power-cycle reset and the most common cause. `}Work through the step-by-step diagnosis in this guide${money_part ? `, and replace the ${money_part.toLowerCase()} only if the checks confirm it has failed.` : `, and confirm the faulty part before replacing anything.`} Most fixes need basic hand tools and the right part.` },
    ];
    return (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
      })} />
    );
  })()}
  <Header />
  <nav class="app-layout post-breadcrumb mt-8 mb-2" aria-label="Breadcrumb" data-pagefind-ignore>
    <ol>
      <li>
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
      </li>
      <li>
        {brandHub ? (
          <a href={`/brands/${brandHub.slug}/`} data-internal-link="brand-hub">{brandHub.name}</a>
        ) : (
          <a href="/posts/">All guides</a>
        )}
        <span aria-hidden="true">&rsaquo;</span>
      </li>
      <li aria-current="page">{title.replace(/—.*$/, "").trim()}</li>
    </ol>
  </nav>
  <main
    id="main-content"
    class="app-layout pb-12"
    data-pagefind-body={isNoindexed ? undefined : true}
  >
    <div class="title-copy-wrapper">
      <h1
        transition:name={slugifyStr(title.replaceAll(".", "-"))}
        class="inline-block text-2xl font-bold text-foreground sm:text-3xl"
      >
        {title}
      </h1>
      {heroCode && (
        <button class="copy-code-btn" data-pagefind-ignore data-code={heroCode} aria-label={`Copy code ${heroCode}`}>
          Copy code
        </button>
      )}
    </div>
    <div class="article-meta" data-pagefind-ignore>
      <span class="article-author">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
        </svg>
        {
          authorData && authorData.slug ? (
            <>
              <a href={`/authors/${authorData.slug}/`}>{authorData.name}</a>
              {authorData.credentials && <span>, {authorData.credentials}</span>}
            </>
          ) : authorData ? (
            <span>{authorData.name}{authorData.credentials ? `, ${authorData.credentials}` : ''}</span>
          ) : (
            <span>Error Code Fixes Editorial Team</span>
          )
        }
      </span>
      <span class="article-date">
        Updated <time datetime={reviewDate.toISOString()} title={reviewDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}>
          {reviewedLabel}
        </time>
      </span>
      <span class="article-read-time">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        {readingMinutes} min read
      </span>
    </div>
    <!-- The one above-the-fold card: code chip, one-line answer, DIY/Pro
         verdict + triage, free checks, and the two jump links. Replaces the
         former QuickAnswer + NoBuyVerdict + brand-hub link + AtAGlance stack
         (the brand-hub link now lives in the breadcrumb above). Rendered first
         so the answer line is the LCP element near the top of the viewport. -->
    <DiagnosisCard
      code={heroCode}
      {description}
      mostLikelyCause={most_likely_cause}
      diyOrPro={diy_or_pro}
      moneyPart={money_part}
      freeChecks={free_checks}
      {tags}
    />

    <!-- "Disconnect the motor" test — only on drive pages with an output-side
         fault. A real, standard field diagnostic that isolates drive vs motor in
         2 minutes; the exact long-tail competitors rank for. -->
    {showNoLoadTest && (
      <aside class="noload-test" data-pagefind-ignore aria-label="Disconnect-the-motor test">
        <p class="nlt-label">2-minute test before you order anything</p>
        <p class="nlt-body">
          Run the drive with the <strong>motor leads disconnected</strong>. If it still trips
          {" "}{heroCode ?? "this fault"}, the problem is inside the drive — the output stage or an
          IGBT module — and the drive needs repair or replacement. If the fault <strong>clears</strong>
          {" "}with no motor connected, the fault is downstream: the motor windings, the motor cable,
          or a short to ground. This one test tells you whether to fix the drive or the motor before
          you spend a dollar.
        </p>
      </aside>
    )}

    <!-- FTC affiliate disclosure: clear, conspicuous, above the parts tables -->
    <AffiliateDisclosure />

    <article
      id="article"
      class="app-prose mt-8 w-full max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    >
      <Content />
    </article>

    <!-- The single parts module, BELOW the free-fix gate. By the time the
         reader is here they have passed the diagnosis card + the fix steps, so
         this click is pre-qualified. #get-the-part is the anchor the diagnosis
         card's "Skip to the part" link jumps to. The chat worker extracts the
         .pc-part / .pc-primary selectors from this card — keep them intact. -->
    {money_part && (
      <div id="get-the-part">
        <PartCallout part={money_part} query={partsQuery} price={part_price} brand={tags?.[0] ?? ""} tags={tags} pro={diy_or_pro === "pro"} />
      </div>
    )}

    <!-- Industrial lead capture: the reader who does NOT want to fix it
         themselves. Tag-gated to the industrial segments; replaces the deleted
         ContractorCTA (untracked angi.com link, wrong trade on VFD pages). -->
    {showQuoteRequest && <QuoteRequest code={heroCode} />}

    <!-- Sticky mobile "get the part" bar: appears after the reader scrolls into
         the fix, so the affiliate click is earned. Mobile only, self-contained. -->
    <StickyPartsBar query={partsQuery} part={money_part} brand={tags?.[0] ?? ''} tags={tags} />

    <hr class="my-8 border-dashed" />

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>

    <BackToTopButton />

    <RelatedPosts currentSlug={post.id} {tags} {posts} />

    <EmailCapture brand={tags?.[0]} category={postCategory} />

    <!-- Field Reference promo: industrial-tagged posts only (same tag gate as
         QuoteRequest above). One sentence + link, next to the email capture. -->
    {showQuoteRequest && (
      <aside class="fr-promo" data-pagefind-ignore>
        <p>
          <span class="fr-promo-label">Offline reference</span>
          Working somewhere with no signal? The
          <a href="/field-reference/">Industrial Fault-Code Field Reference</a>
          packs {frStats.full.codes} code entries across {frStats.full.brands} industrial
          brands into one printable, phone-ready file — free {frStats.sample.brands.join(" + ")} sample.
        </p>
      </aside>
    )}

    <hr class="my-6 border-dashed" />

    <!-- Previous/Next Post Buttons -->
    <div data-pagefind-ignore class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        prevPost && (
          <a
            href={getPath(prevPost.id, prevPost.filePath)}
            class="flex w-full gap-1 hover:opacity-75"
          >
            <IconChevronLeft class="inline-block flex-none rtl:rotate-180" />
            <div>
              <span>Previous Post</span>
              <div class="text-sm font-medium text-foreground">{prevPost.title}</div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={getPath(nextPost.id, nextPost.filePath)}
            class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
          >
            <div>
              <span>Next Post</span>
              <div class="text-sm font-medium text-foreground">{nextPost.title}</div>
            </div>
            <IconChevronRight class="inline-block flex-none rtl:rotate-180" />
          </a>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>

<style>
  /* Visible breadcrumb: Home › {brand hub | All guides} › current page.
     Replaces the old back button; matches the BreadcrumbList JSON-LD. */
  .post-breadcrumb ol {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.15rem 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--foreground) 65%, transparent);
  }
  .post-breadcrumb li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    min-width: 0;
  }
  .post-breadcrumb a {
    color: color-mix(in srgb, var(--foreground) 78%, transparent);
    text-decoration: none;
  }
  .post-breadcrumb a:hover,
  .post-breadcrumb a:focus-visible {
    color: var(--foreground);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .post-breadcrumb li[aria-current="page"] {
    display: inline-block;
    max-width: 32ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
    margin-bottom: 1rem;
  }
  .article-author {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--safe);
    font-weight: 500;
  }
  .article-date { color: color-mix(in srgb, var(--foreground) 68%, transparent); }
  .article-read-time {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
  }

  /* "Disconnect the motor" diagnostic — drive output-fault pages only. */
  .noload-test {
    margin: 0 0 1.5rem;
    padding: 0.85rem 1.1rem 0.95rem;
    background: color-mix(in srgb, var(--brand) 6%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--brand) 22%, var(--border));
