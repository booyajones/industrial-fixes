---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

const pdfUrl = "/resources/industrial-error-code-cheat-sheet.pdf";
const pageUrl = new URL(Astro.url.pathname, SITE.website).href;
---

<Layout
  title={`Your guide is ready | ${SITE.title}`}
  description="Your Industrial Error Code Quick Reference is ready to download."
  canonicalURL={pageUrl}
>
  <Header />
  <main id="main-content" class="app-layout pb-12">
    <section class="mt-10 max-w-2xl">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-800 dark:bg-green-900/30 dark:text-green-400">
        <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
        </svg>
        Subscription confirmed
      </span>

      <h1 class="mt-4 text-3xl font-bold sm:text-4xl">You're in.</h1>

      <p class="mt-4 text-lg text-foreground/80">
        Thanks for joining. Your <strong>Industrial Error Code Quick Reference</strong>
        is ready below — covering the most common HVAC, CNC, refrigeration, and
        boiler fault codes with the first thing to check on each.
      </p>

      <div class="mt-8 rounded-lg border-2 border-accent bg-accent/5 p-5">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="font-bold text-lg">Industrial Error Code Quick Reference</p>
            <p class="text-sm text-foreground/60">PDF · 32 fault codes across 4 equipment categories</p>
          </div>
          <a
            href={pdfUrl}
            download
            class="inline-flex items-center justify-center gap-2 rounded-md bg-accent px-5 py-3 text-sm font-bold text-white hover:bg-accent/85 transition-colors"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download PDF
          </a>
        </div>
      </div>

      <h2 class="mt-10 text-xl font-bold">What's next</h2>
      <ul class="mt-3 space-y-2 text-foreground/80">
        <li>
          → A welcome email is on its way. Check your inbox (and your spam
          folder, just in case).
        </li>
        <li>
          → Have a specific error code right now? Use the
          <a href="/search" class="text-accent hover:underline">site search</a>
          or browse by
          <a href="/equipment/" class="text-accent hover:underline">equipment category</a>.
        </li>
        <li>
          → Bookmark
          <a href="/" class="text-accent hover:underline">errorcodefixes.com</a>
          — new fix guides ship most weeks.
        </li>
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
