---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

// Thank-you page for the industrial QuoteRequest form (POST /api/quote).
// Follows the /thanks/ pattern: static, noindexed, progressive-enhancement
// landing for both the no-JS 303 redirect and the fetch-based redirect.
// Copy stays honest: replies come by email, no response-time promises.
const pageUrl = new URL(Astro.url.pathname, SITE.website).href;
---

<Layout
  title={`Request received | ${SITE.title}`}
  description="Your fault description was sent to our dispatch inbox. We'll reply by email."
  canonicalURL={pageUrl}
  noindex={true}
>
  <Header />
  <main id="main-content" class="app-layout pb-12">
    <section class="mt-10 max-w-2xl">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-800 dark:bg-green-900/30 dark:text-green-400">
        <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
        </svg>
        Request received
      </span>

      <h1 class="mt-4 text-3xl font-bold sm:text-4xl">Got it.</h1>

      <p class="mt-4 text-lg text-foreground/80">
        Your fault description is on its way to our dispatch inbox. We read
        every request and reply by email — watch the address you gave us, and
        check the spam folder the first time.
      </p>

      <h2 class="mt-10 text-xl font-bold">While you wait</h2>
      <ul class="mt-3 space-y-2 text-foreground/80">
        <li>
          → Keep diagnosing: use the
          <a href="/search" class="text-accent hover:underline">site search</a>
          or browse by
          <a href="/equipment/" class="text-accent hover:underline">equipment category</a>.
        </li>
        <li>
          → If the machine is down hard, note the exact fault code and the
          drive/control model and serial — whoever works on it will ask for both.
        </li>
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
