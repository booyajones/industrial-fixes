---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

// Consumer brands only. Industrial brand hubs stay generable but are de-linked
// from this consumer page (P2 quarantine). Order = section order on the page.
const BRAND_LIST = [
  { slug: "samsung", name: "Samsung", category: "Appliances" },
  { slug: "lg", name: "LG", category: "Appliances" },
  { slug: "whirlpool", name: "Whirlpool", category: "Appliances" },
  { slug: "ge", name: "GE", category: "Appliances" },
  { slug: "frigidaire", name: "Frigidaire", category: "Appliances" },
  { slug: "maytag", name: "Maytag", category: "Appliances" },
  { slug: "bosch", name: "Bosch", category: "Appliances" },
  { slug: "kitchenaid", name: "KitchenAid", category: "Appliances" },
  { slug: "kenmore", name: "Kenmore", category: "Appliances" },
  { slug: "electrolux", name: "Electrolux", category: "Appliances" },
  { slug: "amana", name: "Amana", category: "Appliances" },
  { slug: "carrier", name: "Carrier", category: "Heating & Cooling" },
  { slug: "goodman", name: "Goodman", category: "Heating & Cooling" },
  { slug: "lennox", name: "Lennox", category: "Heating & Cooling" },
  { slug: "trane", name: "Trane", category: "Heating & Cooling" },
  { slug: "rheem", name: "Rheem", category: "Heating & Cooling" },
  { slug: "york", name: "York", category: "Heating & Cooling" },
  { slug: "daikin", name: "Daikin", category: "Heating & Cooling" },
  { slug: "mitsubishi", name: "Mitsubishi", category: "Heating & Cooling" },
  { slug: "fujitsu", name: "Fujitsu", category: "Heating & Cooling" },
  { slug: "navien", name: "Navien", category: "Water Heaters" },
  { slug: "rinnai", name: "Rinnai", category: "Water Heaters" },
];

const allPosts = await getCollection("blog");

const brandData = BRAND_LIST.map(({ slug, name, category }) => {
  const count = allPosts.filter(
    post => !post.data.draft && post.data.tags.some(t => t.toLowerCase() === slug)
  ).length;
  return { slug, name, category, count };
});

// Group by category
const categories = [...new Set(BRAND_LIST.map(b => b.category))];

const pageTitle = "Appliance Error Codes by Brand";
const pageDesc = "Browse appliance error code fix guides by brand. Samsung, LG, Whirlpool, GE, Frigidaire, Maytag, Bosch, KitchenAid and more, with the real cause and the exact OEM part for every code.";
---

<Layout title={`${pageTitle} | ${SITE.title}`} description={pageDesc}>
  <Header />
  <main id="main-content" class="app-layout pb-12">
    <nav class="mt-6 mb-2 text-sm text-gray-500">
      <a href="/" class="hover:text-accent">Home</a>
      <span class="mx-1">/</span>
      <span class="font-medium text-foreground">By Brand</span>
    </nav>

    <h1 class="text-3xl font-bold mt-4 mb-2">{pageTitle}</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-10">{pageDesc}</p>

    {categories.map(cat => {
      const catBrands = brandData.filter(b => b.category === cat);
      return (
        <section class="mb-10">
          <h2 class="text-xl font-semibold mb-4 border-b border-border pb-2">{cat}</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
            {catBrands.map(({ slug, name, count }) => (
              <a
                href={`/brands/${slug}/`}
                class="group flex flex-col items-start rounded-lg border border-border p-4 hover:border-accent hover:bg-accent/5 transition-all"
              >
                <span class="text-base font-semibold group-hover:text-accent transition-colors">{name}</span>
                <span class="mt-1 text-sm text-gray-500">
                  {count} {count === 1 ? "guide" : "guides"}
                </span>
              </a>
            ))}
          </div>
        </section>
      );
    })}

    <div class="mt-8 rounded-lg border border-border bg-accent/5 p-6">
      <p class="text-sm text-gray-600 dark:text-gray-400">
        Looking for a different brand? Browse all equipment types in{" "}
        <a href="/tags/" class="text-accent hover:underline font-medium">By Equipment</a>{" "}
        or search directly using the{" "}
        <a href="/search/" class="text-accent hover:underline font-medium">search tool</a>.
      </p>
    </div>
  </main>
  <Footer />
</Layout>
