---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getPath } from "@/utils/getPath";
import { NOINDEX_SLUGS } from "@/data/noindex-slugs";
import { SITE } from "@/config";

const BRAND_DISPLAY: Record<string, string> = {
  // Consumer appliance + HVAC brands (2026-06-02 consumer pivot)
  "samsung": "Samsung",
  "lg": "LG",
  "whirlpool": "Whirlpool",
  "ge": "GE",
  "frigidaire": "Frigidaire",
  "maytag": "Maytag",
  "bosch": "Bosch",
  "kitchenaid": "KitchenAid",
  "kenmore": "Kenmore",
  "electrolux": "Electrolux",
  "amana": "Amana",
  "navien": "Navien",
  "rinnai": "Rinnai",
  "carrier": "Carrier",
  "goodman": "Goodman",
  "lennox": "Lennox",
  "trane": "Trane",
  "rheem": "Rheem",
  "york": "York",
  "daikin": "Daikin",
  "mitsubishi": "Mitsubishi",
  "fujitsu": "Fujitsu",
  "hoshizaki": "Hoshizaki",
  "manitowoc": "Manitowoc",
  "fanuc": "Fanuc",
  "haas": "Haas",
  "yaskawa": "Yaskawa",
  "abb": "ABB",
  "siemens": "Siemens",
  "allen-bradley": "Allen-Bradley",
  "danfoss": "Danfoss",
  "sew-eurodrive": "SEW-Eurodrive",
  "apc": "APC",
  "rational": "Rational",
};

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");

  const brands = [
    // consumer appliance + HVAC brands lead
    "samsung", "lg", "whirlpool", "ge", "frigidaire", "maytag", "bosch",
    "kitchenaid", "kenmore", "electrolux", "amana", "navien", "rinnai",
    "carrier", "goodman", "lennox", "trane", "rheem", "york",
    "daikin", "mitsubishi", "fujitsu", "hoshizaki", "manitowoc",
    "fanuc", "haas", "yaskawa", "abb", "siemens", "allen-bradley", "danfoss",
    "sew-eurodrive", "apc", "rational"
  ];

  return brands.map(brand => {
    const brandPosts = allPosts
      .filter(post => !post.data.draft)
      .filter(post => !NOINDEX_SLUGS.has(post.id))
      .filter(post => post.data.tags.some(t => t.toLowerCase() === brand))
      .sort((a, b) => a.data.title.localeCompare(b.data.title));

    return {
      params: { brand },
      props: { posts: brandPosts },
    };
  });
}

const { brand } = Astro.params;
const { posts } = Astro.props;

// Differentiated, honesty-wedge stat for the hub intro: how many of this brand's
// codes are usually a cheap or free fix (carry a grounded no_buy_pct), not a
// failed part. No competitor surfaces this; it is the link-worthy hook.
const cheapFixCount = posts.filter(p => p.data.no_buy_pct).length;

const BRAND_GROUP: Record<string, "hvac" | "refrigeration" | "industrial" | "appliance" | "kitchen" | "power"> = {
  "samsung": "appliance",
  "lg": "appliance",
  "whirlpool": "appliance",
  "ge": "appliance",
  "frigidaire": "appliance",
  "maytag": "appliance",
  "bosch": "appliance",
  "kitchenaid": "appliance",
  "kenmore": "appliance",
  "electrolux": "appliance",
  "amana": "appliance",
  "navien": "appliance",
  "rinnai": "appliance",
  "carrier": "hvac",
  "goodman": "hvac",
  "lennox": "hvac",
  "trane": "hvac",
  "rheem": "hvac",
  "york": "hvac",
  "daikin": "hvac",
  "mitsubishi": "hvac",
  "fujitsu": "hvac",
  "hoshizaki": "refrigeration",
  "manitowoc": "refrigeration",
  "fanuc": "industrial",
  "haas": "industrial",
  "yaskawa": "industrial",
  "abb": "industrial",
  "siemens": "industrial",
  "allen-bradley": "industrial",
  "danfoss": "industrial",
  "sew-eurodrive": "industrial",
  "apc": "power",
  "rational": "kitchen",
};

const brandName = BRAND_DISPLAY[brand] ?? brand;
const pageTitle = `${brandName} Error Code Reference — All ${posts.length} Codes`;
const pageDesc = `Complete ${brandName} error code cheat sheet. All ${posts.length} fault codes with plain-English explanations and direct links to fix guides.`;
const brandGroup = BRAND_GROUP[brand] ?? "hvac";
const introCopy = {
  appliance: `Use this page when your ${brandName} appliance is showing an error or fault code. Start with the exact code, then open the fix guide to find the real cause and the exact OEM part before you order parts or book a repair. Coverage spans washers, dryers, refrigerators, dishwashers, ranges, ovens and more.`,
  hvac: `Use this page when your ${brandName} furnace, air conditioner, heat pump, or mini split is flashing a fault. Start with the exact code, then open the fix guide to diagnose airflow, ignition, sensor, pressure switch, board, or communication problems before you order parts or book a service call.`,
  refrigeration: `Use this page when your ${brandName} ice machine, reach-in cooler, freezer, or prep table throws an alarm. Start with the exact code, then work through the matching guide for probe faults, defrost issues, water flow problems, warm box alarms, and ice production failures.`,
  industrial: `Use this page when your ${brandName} drive, CNC, servo, or controls hardware posts an alarm during production. Start with the exact code, then open the fix guide for overloads, encoder faults, communication alarms, power quality issues, and drive or board failures.`,
  kitchen: `Use this page when your ${brandName} combi oven, warewasher, or other commercial kitchen equipment shows a service or error code mid-shift. Start with the exact code, then open the fix guide for probe faults, water and drain problems, heating failures, and control board issues.`,
  power: `Use this page when your ${brandName} UPS, generator, or power equipment reports a fault or alarm. Start with the exact code, then open the fix guide for battery faults, overload conditions, transfer problems, and inverter or charger failures.`
}[brandGroup];
const searchHint = {
  appliance: `Tip: search the exact appliance and code together, for example "${brandName} washer LE" or "${brandName} refrigerator 22E".`,
  hvac: `Tip: search the exact brand, model, and code together, for example "${brandName} error code 13" or "${brandName} pressure switch fault".` ,
  refrigeration: `Tip: search the exact brand, model, and alarm together, for example "${brandName} E2" or "${brandName} freeze cycle timeout".` ,
  industrial: `Tip: search the exact brand, model, and alarm together, for example "${brandName} F0001" or "${brandName} overcurrent fault".`,
  kitchen: `Tip: search the exact brand, model, and code together, for example "${brandName} E13" or "${brandName} not draining".`,
  power: `Tip: search the exact brand, model, and code together, for example "${brandName} F01" or "${brandName} overload alarm".`
}[brandGroup];
---

<Layout title={`${pageTitle} | ${SITE.title}`} description={pageDesc}>
  <Header />
  <main id="main-content" class="app-layout pb-12">
    <nav class="mt-6 mb-2 text-sm text-gray-500">
      <a href="/" class="hover:text-accent">Home</a>
      <span class="mx-1">/</span>
      <a href="/brands/" class="hover:text-accent">By Brand</a>
      <span class="mx-1">/</span>
      <span class="font-medium text-foreground">{brandName}</span>
    </nav>

    <h1 class="text-3xl font-bold mt-4 mb-2">{pageTitle}</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-3">{pageDesc}</p>
    <div class="mb-8 rounded-lg border border-border bg-accent/5 p-4">
      <p class="mb-3 text-sm leading-6 text-gray-700 dark:text-gray-300">{introCopy}</p>
      {cheapFixCount > 0 && (
        <p class="mb-3 text-sm font-medium text-safe">
          We don't sell parts, so we'll tell you when not to buy one: {cheapFixCount} of these {brandName} codes are usually a cheap or free fix, not a failed part. The "Often a cheap fix?" column shows the odds.
        </p>
      )}
      <p class="text-sm font-medium text-accent">{searchHint}</p>
    </div>

    {posts.length === 0 ? (
      <p class="italic text-gray-500">No error code guides found for {brandName} yet.</p>
    ) : (
      <div class="overflow-x-auto rounded-lg border border-border">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-accent/10 text-left">
              <th class="px-4 py-3 font-semibold w-1/4">Error Code</th>
              <th class="px-4 py-3 font-semibold">What It Means</th>
              <th class="px-4 py-3 font-semibold w-28 text-center">Often a cheap fix?</th>
              <th class="px-4 py-3 font-semibold w-24 text-center">Guide</th>
            </tr>
          </thead>
          <tbody>
            {posts.map((post, i) => {
              const href = getPath(post.id, post.filePath) + "/";
              const titleParts = post.data.title.split(/\s[—\-]\s/);
              const codeLabel = titleParts[0]?.trim() ?? post.data.title;
              const what = titleParts.slice(1).join(" — ").trim() || post.data.description;
              const pct = post.data.no_buy_pct;
              return (
                <tr class:list={["border-t border-border", i % 2 === 0 ? "bg-background" : "bg-accent/5"]}>
                  <td class="px-4 py-3 font-mono text-accent font-semibold align-top">
                    <a href={href} class="hover:underline">{codeLabel}</a>
                  </td>
                  <td class="px-4 py-3 text-gray-700 dark:text-gray-300 align-top">{what}</td>
                  <td class="px-4 py-3 text-center align-top whitespace-nowrap">
                    {pct ? (
                      <span class="rounded-full bg-safe/15 px-2 py-1 text-xs font-bold text-safe">~{pct} yes</span>
                    ) : (
                      <span class="text-xs text-gray-400">—</span>
                    )}
                  </td>
                  <td class="px-4 py-3 text-center align-top">
                    <a
                      href={href}
                      class="inline-block rounded bg-accent px-3 py-1 text-xs font-semibold text-white hover:opacity-90 transition-opacity"
                    >
                      Fix →
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}

    <div class="mt-10 text-center">
      <a
        href={`/tags/${brand}/`}
        class="inline-block rounded-lg border border-accent px-6 py-3 font-semibold text-accent hover:bg-accent hover:text-white transition-colors"
      >
        View all {brandName} guides →
      </a>
    </div>
  </main>
  <Footer />
</Layout>
