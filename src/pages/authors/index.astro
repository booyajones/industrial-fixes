---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { SITE } from "@/config";

// Editorial team data. Each entry mirrors the frontmatter on the
// individual author page so we don't have to import markdown files
// at build time.
const team = [
  {
    slug: "dana-kowalski",
    name: "Dana Kowalski",
    title: "Industrial Controls & VFD Specialist",
    credentials: "Certified Automation Professional (CAP)",
    expertise: "VFDs, PLCs, CNC servo and spindle systems",
    initials: "DK",
    accent: "bg-blue-100 text-blue-900 dark:bg-blue-900/30 dark:text-blue-300",
  },
  {
    slug: "marcus-webb",
    name: "Marcus Webb",
    title: "HVAC & Refrigeration Lead",
    credentials: "EPA 608 Universal · NATE Certified",
    expertise: "Residential and commercial HVAC, refrigerants, controls",
    initials: "MW",
    accent: "bg-amber-100 text-amber-900 dark:bg-amber-900/30 dark:text-amber-300",
  },
  {
    slug: "james-rutherford",
    name: "James Rutherford",
    title: "Commercial Kitchen Equipment Editor",
    credentials: "CFESA Certified · 18 years field experience",
    expertise: "Ice machines, combi ovens, fryers, commercial dishwashers",
    initials: "JR",
    accent: "bg-emerald-100 text-emerald-900 dark:bg-emerald-900/30 dark:text-emerald-300",
  },
];

// Count published articles per author.
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const teamWithCounts = team.map(t => ({
  ...t,
  count: allPosts.filter(p => p.data.author === t.name).length,
}));
const totalAttributed = teamWithCounts.reduce((s, t) => s + t.count, 0);

const pageUrl = new URL(Astro.url.pathname, SITE.website).href;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.title,
  url: SITE.website,
  member: teamWithCounts.map(t => ({
    "@type": "Person",
    name: t.name,
    jobTitle: t.title,
    honorificSuffix: t.credentials,
    url: `${SITE.website}authors/${t.slug}/`,
  })),
};
---

<Layout
  title={`Editorial Team | ${SITE.title}`}
  description="The certified technicians and editors behind every fix guide on errorcodefixes.com. Each guide is written or reviewed by a credentialed pro in the relevant trade."
  canonicalURL={pageUrl}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} />
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout">
    <section class="py-10 border-b border-border">
      <h1 class="text-3xl font-bold sm:text-4xl">Editorial Team</h1>
      <p class="mt-3 text-lg text-foreground/80 max-w-2xl">
        Every fix guide on this site is written or reviewed by a credentialed
        technician in the relevant trade. No AI shovel-ware, no rewritten
        manuals — guides come out of hands-on field experience and OEM
        service documentation.
      </p>
      <div class="mt-4 inline-flex items-center gap-2 rounded-full bg-muted px-4 py-1.5 text-sm">
        <span class="font-bold tabular-nums">{totalAttributed.toLocaleString()}</span>
        <span class="text-foreground/70">guides published by named technicians</span>
      </div>
    </section>

    <section class="py-10">
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {teamWithCounts.map(t => (
          <li class="rounded-lg border border-border bg-muted/30 p-5 hover:border-accent hover:bg-accent/5 transition-all">
            <a href={`/authors/${t.slug}/`} class="block">
              <div class="flex items-start gap-4">
                <div
                  class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-full text-lg font-bold ${t.accent}`}
                >
                  {t.initials}
                </div>
                <div class="min-w-0 flex-1">
                  <h2 class="text-lg font-bold leading-tight">{t.name}</h2>
                  <p class="mt-1 text-sm text-foreground/70">{t.title}</p>
                </div>
              </div>
              <p class="mt-3 text-xs font-medium text-foreground/60">
                {t.credentials}
              </p>
              <p class="mt-3 text-sm text-foreground/80">{t.expertise}</p>
              <div class="mt-4 flex items-center justify-between border-t border-border pt-3">
                <span class="text-sm font-semibold text-accent">
                  {t.count.toLocaleString()} guides
                </span>
                <span class="text-xs text-foreground/60">View profile →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-10 rounded-lg border border-border bg-muted/30 p-6">
        <h2 class="text-lg font-bold">How we work</h2>
        <ul class="mt-3 space-y-2 text-sm text-foreground/80">
          <li>
            <strong>Manufacturer-first sourcing.</strong> Every error code
            and parameter is checked against OEM service literature before
            it reaches publication.
          </li>
          <li>
            <strong>Field-tested diagnostics.</strong> Our authors have
            collectively worked on every brand we cover. Diagnostic steps
            reflect what actually finds the root cause, not what fills
            page count.
          </li>
          <li>
            <strong>Specific over generic.</strong> "Replace the board"
            isn't a fix. We list voltage and resistance test ranges,
            microamp targets, and OEM part numbers wherever they apply.
          </li>
          <li>
            <strong>Independent.</strong> No manufacturer pays us to
            recommend their parts. When we link to a part, the
            recommendation is editorial.
          </li>
        </ul>
      </div>
    </section>
    <Footer />
  </main>
</Layout>
