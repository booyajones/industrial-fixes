---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { SITE } from "@/config";

// Honest editorial-team page. No fabricated named "technicians" or licenses.
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const totalPublished = allPosts.length;

const pageUrl = new URL(Astro.url.pathname, SITE.website).href;

// Organization schema only — no fabricated Person members.
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.title,
  url: SITE.website,
  description:
    "Consumer appliance error-code and repair guides, researched against manufacturer documentation and reviewed before publishing.",
};
---

<Layout
  title={`Editorial Team | ${SITE.title}`}
  description="How Error Code Fixes researches and reviews every appliance error-code and repair guide: manufacturer documentation first, plain DIY-focused guidance, and a safety-first line on pro-only work."
  canonicalURL={pageUrl}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} />
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout">
    <section class="py-10 border-b border-border">
      <h1 class="text-3xl font-bold sm:text-4xl">Editorial Team</h1>
      <p class="mt-3 text-lg text-foreground/80 max-w-2xl">
        Error Code Fixes is researched and maintained by a small editorial team.
        Every guide is built from manufacturer service documentation and
        published repair sources, then reviewed before it goes live. We are not
        the manufacturer and we are not a repair service. We help you understand
        your error code and find the right part to fix it.
      </p>
      <div class="mt-4 inline-flex items-center gap-2 rounded-full bg-muted px-4 py-1.5 text-sm">
        <span class="font-bold tabular-nums">{totalPublished.toLocaleString()}</span>
        <span class="text-foreground/70">fix guides published</span>
      </div>
    </section>

    <section class="py-10">
      <div class="rounded-lg border border-border bg-muted/30 p-6 max-w-2xl">
        <h2 class="text-lg font-bold">How we work</h2>
        <ul class="mt-3 space-y-3 text-sm text-foreground/80">
          <li>
            <strong>Manufacturer-first sourcing.</strong> Error codes, causes,
            and fixes are checked against manufacturer service literature and
            established repair sources before a guide is published.
          </li>
          <li>
            <strong>Plain and specific.</strong> We name the most likely cause
            and the specific part to check, not "replace the board." Where a code
            or part is brand-and-model specific, we say so.
          </li>
          <li>
            <strong>Safety first.</strong> Work involving gas, refrigerant,
            sealed systems, or high voltage is flagged for a licensed
            technician rather than written up as a DIY fix.
          </li>
          <li>
            <strong>Independent and transparent.</strong> Some links to parts
            are affiliate links, disclosed on every guide. No manufacturer pays
            us for placement; part recommendations are editorial.
          </li>
          <li>
            <strong>We fix our mistakes.</strong> Spotted something wrong in a
            guide? Tell us and we will correct it. Accuracy matters more than
            page count.
          </li>
        </ul>
      </div>
    </section>
    <Footer />
  </main>
</Layout>
