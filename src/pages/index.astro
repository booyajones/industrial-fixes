---
import "@pagefind/default-ui/css/ui.css";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

// Most popular this week — auto-fed by scripts/weekly-traffic-report.py
// which writes src/data/top-this-week.json from GA4 every Monday 7am.
// The homepage re-renders on the next commit cycle so the list stays
// fresh without manual touch.
let topThisWeek: Array<{ slug: string; path: string; pageviews: number; title: string }> = [];
try {
  const topData = (await import("@/data/top-this-week.json")).default as {
    articles: Array<{ slug: string; path: string; pageviews: number }>;
  };
  const bySlug = new Map(posts.map(p => [p.id.replace(/\.md$/, ""), p]));
  topThisWeek = topData.articles
    .map(a => {
      const post = bySlug.get(a.slug);
      return post
        ? { slug: a.slug, path: a.path, pageviews: a.pageviews, title: post.data.title }
        : null;
    })
    .filter((x): x is { slug: string; path: string; pageviews: number; title: string } => x !== null)
    .slice(0, 6);
} catch {
  // top-this-week.json not present (first run / fresh checkout). Section
  // simply doesn't render — graceful degradation.
}

// Equipment categories pulled from the shared data file so the homepage,
// the /equipment/ index, and each /equipment/[slug]/ hub stay in sync.
import { equipmentCategories } from "@/data/equipmentCategories";
const categories = equipmentCategories.map(c => ({
  name: c.name,
  emoji: c.emoji,
  slug: c.slug,
  desc: c.tagline,
}));
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">

    <!-- Hero Section -->
    <section id="hero" class="py-10 border-b border-border">
      <div class="flex items-center gap-3 mb-2">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-800 dark:bg-green-900/30 dark:text-green-400">
          <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          Verified Fix Guides
        </span>
        <span class="text-xs text-foreground/50">Updated 2026</span>
      </div>

      <h1 class="my-3 text-3xl font-bold sm:text-4xl leading-tight">
        The Industrial Error Code Library
      </h1>
      <p class="text-lg text-foreground/80 max-w-xl">
        Technician-written diagnostic guides for HVAC, CNC, VFD, refrigeration,
        boilers, and commercial equipment. Real OEM part numbers, voltage and
        resistance ranges, step-by-step fix trees. No paywall, no email gate.
      </p>

      <!-- Authority bar: the actual numbers behind our coverage claim. -->
      <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <div class="flex items-baseline gap-1.5">
          <span class="font-bold text-accent text-xl tabular-nums">{sortedPosts.length.toLocaleString()}+</span>
          <span class="text-foreground/70">fix guides</span>
        </div>
        <div class="flex items-baseline gap-1.5">
          <span class="font-bold text-accent text-xl tabular-nums">30+</span>
          <span class="text-foreground/70">manufacturers</span>
        </div>
        <div class="flex items-baseline gap-1.5">
          <span class="font-bold text-accent text-xl tabular-nums">6</span>
          <span class="text-foreground/70">equipment categories</span>
        </div>
        <div class="flex items-baseline gap-1.5">
          <span class="font-bold text-accent text-xl">Free</span>
          <span class="text-foreground/70">forever</span>
        </div>
      </div>

      <!-- Real Pagefind search above the fold. Users arrive knowing the
           code they're trying to fix — this is one click instead of two. -->
      <div id="pagefind-home" class="mt-6 max-w-lg">
        <!-- Fallback link in case JS fails / Pagefind isn't built yet -->
        <noscript>
          <a href="/search" class="flex items-center gap-3 w-full rounded-lg border-2 border-accent bg-muted px-4 py-3 text-foreground/60">
            <svg class="h-5 w-5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <span>Search error codes...</span>
          </a>
        </noscript>
      </div>

      <!-- Equipment category grid -->
      <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3">
        {categories.map(cat => (
          <a
            href={`/equipment/${cat.slug}/`}
            class="flex flex-col gap-1 rounded-lg border border-border bg-muted p-3 hover:border-accent hover:bg-accent/5 transition-all"
          >
            <span class="text-xl">{cat.emoji}</span>
            <span class="font-semibold text-sm">{cat.name}</span>
            <span class="text-xs text-foreground/50">{cat.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Featured Posts -->
    {featuredPosts.length > 0 && (
      <section id="featured" class="pt-10 pb-6 border-b border-border">
        <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
          <svg class="h-5 w-5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          Most Common Fixes
        </h2>
        <ul>
          {featuredPosts.map(data => <Card variant="h3" {...data} />)}
        </ul>
      </section>
    )}

    {topThisWeek.length > 0 && (
      <section id="top-this-week" class="pt-10 pb-6 border-b border-border">
        <h2 class="text-xl font-bold mb-1 flex items-center gap-2">
          <svg class="h-5 w-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
          </svg>
          Most popular fixes this week
        </h2>
        <p class="text-sm text-foreground/60 mb-4">Auto-updated from real reader traffic, refreshed weekly.</p>
        <ol class="grid gap-2 sm:grid-cols-2">
          {topThisWeek.map((article, i) => (
            <li class="flex items-baseline gap-3 rounded-md border border-border bg-muted/30 px-3 py-2 hover:border-accent hover:bg-accent/5 transition-all">
              <span class="text-lg font-bold text-accent tabular-nums">{i + 1}</span>
              <a href={article.path} class="text-sm font-medium hover:text-accent transition-colors">
                {article.title}
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- Recent Posts -->
    {recentPosts.length > 0 && (
      <section id="recent-posts" class="pt-10 pb-6">
        <h2 class="text-xl font-bold mb-4">All Fix Guides</h2>
        <ul>
          {recentPosts.map((data, index) =>
            index < SITE.postPerIndex && <Card variant="h3" {...data} />
          )}
        </ul>
      </section>
    )}

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        View All Fix Guides
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>

  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>

<script>
  function initHomeSearch() {
    const el = document.querySelector("#pagefind-home");
    if (!el) return;
    // Already initialized
    if (el.querySelector("form")) return;

    const onIdle = window.requestIdleCallback || ((cb: TimerHandler) => setTimeout(cb, 1));
    onIdle(async () => {
      if (import.meta.env.DEV) {
        el.innerHTML = `<p style="font-size:0.8rem;color:#888;">Search available after first build.</p>`;
        return;
      }
      // @ts-expect-error — Missing types for @pagefind/default-ui package.
      const { PagefindUI } = await import("@pagefind/default-ui");
      new PagefindUI({
        element: "#pagefind-home",
        showImages: false,
        showSubResults: false,
      });
    });
  }

  document.addEventListener("astro:after-swap", initHomeSearch);
  initHomeSearch();
</script>

<style is:global>
  #pagefind-home {
    --pagefind-ui-font: var(--font-app);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-tag: var(--background);
    --pagefind-ui-border-radius: 0.375rem;
    --pagefind-ui-border-width: 1px;
    max-width: 600px;
  }
  #pagefind-home input {
    font-weight: 400;
    border: 1px solid var(--border);
  }
  #pagefind-home input:focus-visible {
    outline: 1px solid var(--accent);
  }
  #pagefind-home .pagefind-ui__result-title a {
    color: var(--accent);
  }
</style>
