---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

// Equipment categories with icons and tag mappings
const categories = [
  { name: "HVAC", emoji: "❄️", tag: "hvac", desc: "Carrier, Daikin, Mitsubishi, Trane" },
  { name: "CNC Machines", emoji: "⚙️", tag: "fanuc", desc: "Fanuc, Haas, Mazak, Siemens" },
  { name: "Refrigeration", emoji: "🧊", tag: "refrigeration", desc: "Walk-in coolers, reach-in, ice machines" },
  { name: "Boilers", emoji: "🔥", tag: "boiler", desc: "Burnham, Weil-McLain, Carrier" },
  { name: "Compressors", emoji: "🔧", tag: "compressor", desc: "Rotary screw, reciprocating, centrifugal" },
  { name: "Electrical", emoji: "⚡", tag: "electrical", desc: "MCC, VFD, switchgear, UPS" },
];
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">

    <!-- Hero Section -->
    <section id="hero" class="py-10 border-b border-border">
      <div class="flex items-center gap-3 mb-2">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-800 dark:bg-green-900/30 dark:text-green-400">
          <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          Verified Fix Guides
        </span>
        <span class="text-xs text-foreground/50">Updated 2024</span>
      </div>

      <h1 class="my-3 text-3xl font-bold sm:text-4xl leading-tight">
        Industrial Error Code Fixes
      </h1>
      <p class="text-lg text-foreground/80 max-w-xl">
        Fast troubleshooting guides for HVAC, CNC, refrigeration and commercial equipment.
        Find your error code — get the fix and the part.
      </p>

      <!-- Search bar -->
      <div class="mt-6 max-w-lg">
        <a
          href="/search"
          class="flex items-center gap-3 w-full rounded-lg border-2 border-accent bg-muted px-4 py-3 text-foreground/60 hover:border-accent/70 transition-colors cursor-pointer"
        >
          <svg class="h-5 w-5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <span>Search error codes... (e.g. "Carrier 34", "Fanuc 300")</span>
        </a>
      </div>

      <!-- Equipment category grid -->
      <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3">
        {categories.map(cat => (
          <a
            href={`/tags/${cat.tag}/`}
            class="flex flex-col gap-1 rounded-lg border border-border bg-muted p-3 hover:border-accent hover:bg-accent/5 transition-all"
          >
            <span class="text-xl">{cat.emoji}</span>
            <span class="font-semibold text-sm">{cat.name}</span>
            <span class="text-xs text-foreground/50">{cat.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Featured Posts -->
    {featuredPosts.length > 0 && (
      <section id="featured" class="pt-10 pb-6 border-b border-border">
        <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
          <svg class="h-5 w-5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          Most Common Fixes
        </h2>
        <ul>
          {featuredPosts.map(data => <Card variant="h3" {...data} />)}
        </ul>
      </section>
    )}

    <!-- Recent Posts -->
    {recentPosts.length > 0 && (
      <section id="recent-posts" class="pt-10 pb-6">
        <h2 class="text-xl font-bold mb-4">All Fix Guides</h2>
        <ul>
          {recentPosts.map((data, index) =>
            index < SITE.postPerIndex && <Card variant="h3" {...data} />
          )}
        </ul>
      </section>
    )}

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        View All Fix Guides
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>

  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
