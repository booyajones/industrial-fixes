---
import "@pagefind/default-ui/css/ui.css";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import getListablePosts from "@/utils/getListablePosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { consumerCategories, industrialCategories } from "@/data/equipmentCategories";
import topData from "@/data/top-this-week.json";
import ApplianceIcon from "@/components/ApplianceIcon.astro";

const ICON_KEY: Record<string, string> = {
  washers: "washer", dryers: "dryer", refrigerators: "refrigerator",
  dishwashers: "dishwasher", "ranges-ovens": "range", microwaves: "microwave",
  furnaces: "furnace", "mini-splits": "mini-split", "water-heaters": "water-heater",
  hvac: "hvac", cnc: "cnc", refrigeration: "refrigeration",
  boilers: "boiler", compressors: "compressor", electrical: "electrical",
};

// Industrial brand hubs — the audience that actually visits this site.
const INDUSTRIAL_BRANDS: Array<[string, string]> = [
  ["fanuc", "Fanuc"], ["siemens", "Siemens"], ["abb", "ABB"],
  ["yaskawa", "Yaskawa"], ["allen-bradley", "Allen-Bradley"],
  ["danfoss", "Danfoss"], ["haas", "Haas"], ["sew-eurodrive", "SEW-Eurodrive"],
  ["york", "York"], ["trane", "Trane"], ["hoshizaki", "Hoshizaki"],
  ["manitowoc", "Manitowoc"], ["rational", "Rational"], ["apc", "APC"],
];

const posts = await getCollection("blog");
const sortedPosts = getListablePosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

// Most popular this week — auto-fed by scripts/weekly-traffic-report.py
// which writes src/data/top-this-week.json from GA4 every Monday 7am.
// The homepage re-renders on the next commit cycle so the list stays
// fresh without manual touch.
const _bySlug = new Map(posts.map(p => [p.id.replace(/\.md$/, ""), p]));
const topThisWeek = (topData.articles || [])
  .map(a => {
    const post = _bySlug.get(a.slug);
    return post ? { path: a.path, title: post.data.title } : null;
  })
  .filter(Boolean)
  .slice(0, 6) as Array<{ path: string; title: string }>;

// Equipment categories pulled from the shared data file so the homepage,
// the /equipment/ index, and each /equipment/[slug]/ hub stay in sync.
// Industrial leads: every engaged human session on this site lands on
// industrial pages (Fanuc, ABB, York, Hoshizaki...), so the front door
// serves that audience first. Consumer appliances stay, demoted.
const industrial = industrialCategories.map(c => ({
  name: c.name, slug: c.slug, desc: c.tagline,
}));
const consumer = consumerCategories.map(c => ({
  name: c.name, slug: c.slug,
}));
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">

    <!-- Hero Section -->
    <section id="hero" class="py-10 border-b border-border">
      <div class="flex items-center gap-3 mb-2">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-muted/40 px-3 py-1 text-xs font-semibold text-foreground/80">
          Independent — we don't sell parts
        </span>
        <span class="text-xs text-foreground/70">Updated 2026</span>
      </div>

      <h1 class="my-3 text-3xl font-bold sm:text-4xl leading-tight">
        Look up an equipment fault code
      </h1>
      <p class="text-lg text-foreground/80 max-w-xl">
        Step-by-step diagnosis for CNC controls, VFDs, chillers, ice machines,
        commercial kitchen equipment — and household appliances. What the code
        means, what actually causes it, and when <em>not</em> to buy the part.
        No paywall, no email gate.
      </p>

      <!-- Authority bar: the actual numbers behind our coverage claim. -->
      <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <div class="flex items-baseline gap-1.5">
          <span class="font-bold text-accent text-xl tabular-nums">{sortedPosts.length.toLocaleString()}+</span>
          <span class="text-foreground/70">fix guides</span>
        </div>
        <div class="flex items-baseline gap-1.5">
          <span class="font-bold text-accent text-xl tabular-nums">40+</span>
          <span class="text-foreground/70">brands</span>
        </div>
        <div class="flex items-baseline gap-1.5">
          <span class="font-bold text-accent text-xl tabular-nums">{industrial.length + consumer.length}</span>
          <span class="text-foreground/70">equipment categories</span>
        </div>
        <div class="flex items-baseline gap-1.5">
          <span class="font-bold text-accent text-xl">Free</span>
          <span class="text-foreground/70">forever</span>
        </div>
      </div>

      <!-- Real Pagefind search above the fold. Users arrive knowing the
           code they're trying to fix — this is one click instead of two. -->
      <div id="pagefind-home" class="mt-6 max-w-lg">
        <!-- Fallback link in case JS fails / Pagefind isn't built yet -->
        <noscript>
          <a href="/search" class="flex items-center gap-3 w-full rounded-lg border-2 border-accent bg-muted px-4 py-3 text-foreground/60">
            <svg class="h-5 w-5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <span>Search error codes...</span>
          </a>
        </noscript>
      </div>

      <p class="mt-3 text-sm">
        <a href="/diagnose" class="inline-flex items-center gap-1.5 font-semibold text-accent hover:underline">
          Not sure of your code? Use the guided diagnosis
          <span aria-hidden="true">&rarr;</span>
        </a>
      </p>

      <!-- Industrial & commercial equipment — the primary grid -->
      <h2 class="mt-8 mb-3 text-sm font-semibold uppercase tracking-wide text-foreground/60">
        Industrial &amp; commercial
      </h2>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        {industrial.map(cat => (
          <a
            href={`/equipment/${cat.slug}/`}
            class="flex flex-col gap-1.5 rounded-xl border border-border bg-surface p-4 hover:border-brand hover:shadow-sm transition-all"
          >
            <ApplianceIcon name={ICON_KEY[cat.slug] ?? "electrical"} class="text-brand" />
            <span class="font-semibold text-sm mt-1">{cat.name}</span>
            <span class="text-xs text-foreground/70">{cat.desc}</span>
          </a>
        ))}
      </div>

      <!-- Industrial brand hubs -->
      <div class="mt-4 flex flex-wrap gap-2">
        {INDUSTRIAL_BRANDS.map(([slug, label]) => (
          <a
            href={`/brands/${slug}/`}
            class="rounded-full border border-border bg-muted/30 px-3 py-1 text-xs font-medium text-foreground/80 hover:border-accent hover:text-accent transition-colors"
          >
            {label}
          </a>
        ))}
      </div>

      <!-- Home appliances — demoted but present -->
      <h2 class="mt-8 mb-3 text-sm font-semibold uppercase tracking-wide text-foreground/60">
        Home appliances
      </h2>
      <div class="flex flex-wrap gap-2">
        {consumer.map(cat => (
          <a
            href={`/equipment/${cat.slug}/`}
            class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-3 py-2 text-sm font-medium hover:border-brand transition-colors"
          >
            <ApplianceIcon name={ICON_KEY[cat.slug] ?? "range"} class="text-brand h-5 w-5" />
            {cat.name}
          </a>
        ))}
      </div>
    </section>

    {topThisWeek.length > 0 && (
      <section id="top-this-week" class="pt-10 pb-6 border-b border-border">
        <h2 class="text-xl font-bold mb-1 flex items-center gap-2">
          <svg class="h-5 w-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
          </svg>
          Most popular fixes this week
        </h2>
        <p class="text-sm text-foreground/60 mb-4">Auto-updated from real reader traffic, refreshed weekly.</p>
        <ol class="grid gap-2 sm:grid-cols-2">
          {topThisWeek.map((article, i) => (
            <li class="flex items-baseline gap-3 rounded-md border border-border bg-muted/30 px-3 py-2 hover:border-accent hover:bg-accent/5 transition-all">
              <span class="text-lg font-bold text-accent tabular-nums">{i + 1}</span>
              <a href={article.path} class="text-sm font-medium hover:text-accent transition-colors">
                {article.title}
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- Featured Posts -->
    {featuredPosts.length > 0 && (
      <section id="featured" class="pt-10 pb-6 border-b border-border">
        <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
          <svg class="h-5 w-5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          Code lookup hubs
        </h2>
        <ul>
          {featuredPosts.map(data => <Card variant="h3" {...data} />)}
        </ul>
      </section>
    )}

    <!-- Recent Posts -->
    {recentPosts.length > 0 && (
      <section id="recent-posts" class="pt-10 pb-6">
        <h2 class="text-xl font-bold mb-4">All Fix Guides</h2>
        <ul>
          {recentPosts.map((data, index) =>
            index < SITE.postPerIndex && <Card variant="h3" {...data} />
          )}
        </ul>
      </section>
    )}

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        View All Fix Guides
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>

  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>

<script>
  function initHomeSearch() {
    const el = document.querySelector("#pagefind-home");
    if (!el) return;
    // Already initialized
    if (el.querySelector("form")) return;

    const onIdle = window.requestIdleCallback || ((cb: TimerHandler) => setTimeout(cb, 1));
    onIdle(async () => {
      if (import.meta.env.DEV) {
        el.innerHTML = `<p style="font-size:0.8rem;color:#888;">Search available after first build.</p>`;
        return;
      }
      const { PagefindUI } = await import("@pagefind/default-ui");
      new PagefindUI({
        element: "#pagefind-home",
        showImages: false,
        showSubResults: false,
        translations: { placeholder: "Enter your code (e.g. Alarm 10, F00021, 2310, E1, LE)" },
      });
    });
  }

  document.addEventListener("astro:after-swap", initHomeSearch);
  initHomeSearch();
</script>

<style is:global>
  #pagefind-home {
    --pagefind-ui-font: var(--font-app);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-tag: var(--background);
    --pagefind-ui-border-radius: 0.375rem;
    --pagefind-ui-border-width: 1px;
    max-width: 600px;
  }
  #pagefind-home input {
    font-weight: 400;
    border: 1px solid var(--border);
  }
  #pagefind-home input:focus-visible {
    outline: 1px solid var(--accent);
  }
  #pagefind-home .pagefind-ui__result-title a {
    color: var(--accent);
  }
</style>
