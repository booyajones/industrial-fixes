---
// "Get the part" — the SINGLE parts module, rendered once at the end of the
// article inside the #get-the-part anchor. Replaces the old PartCallout +
// PartsSpecialist back-to-back duplication (PartsSpecialist's divergent inline
// merchant rules routed 36 posts to Parts Town, which pays $0, and misrouted
// 24 industrial posts — pickMerchant below is the one canonical router).
//
// SELECTOR CONTRACT: the chat worker (workers/chat-api/index.js) extracts
//   class="pc-part"   -> the part name text
//   class="pc-primary" ... href="..." -> the monetized link (class BEFORE href)
// from this card's rendered HTML. Keep those exact attributes in that order.
import { pickMerchant } from "@/utils/partMerchant";

interface Props {
  part: string;
  query: string;
  price?: string;
  brand?: string;
  tags?: readonly string[];
  pro?: boolean;
}
const { part, query, price, brand = "", tags = [], pro = false } = Astro.props;

// PRIMARY: the merchant that actually stocks this equipment class' parts
// (industrial -> Grainger, consumer -> RepairClinic, ...). Skimlinks monetizes
// the click. The chatbot extracts THIS link, so fixing it fixes the chat too.
const merchant = pickMerchant(tags);
const merchantHref = merchant.url(query);

// SECONDARY: plain-text Amazon link (Associates, noskim so Skimlinks never
// skims it), always a search URL. parts.json ASIN deeplinks can't apply here:
// it is keyed by OEM part NUMBERS ("T-84984") while money_part is a
// descriptive name — wiring verified ASINs needs a future part-number
// frontmatter field. NEVER guess ASINs (CLAUDE.md hard don't).
const TAG = "errorcodefixes-20";
const amazonHref = `https://www.amazon.com/s?k=${encodeURIComponent(part)}&tag=${TAG}`;
---

<aside class="part-callout" data-pagefind-ignore aria-label="Get the part">
  <div class="pc-head">
    <span class="pc-label">Get the part</span>
  </div>
  <div class="pc-part">{part}</div>
  {price && <div class="pc-price">Typically {price}</div>}
  <div class="pc-actions">
    <a
      class="pc-primary"
      href={merchantHref}
      target="_blank"
      rel="sponsored noopener"
      data-affiliate-network="skimlinks"
      data-affiliate-kind="part-callout"
      data-affiliate-placement="get_the_part"
      data-affiliate-brand={brand}
    >
      Find it at {merchant.name}
      <span aria-hidden="true">&rarr;</span>
    </a>
    <a
      class="pc-secondary noskim"
      href={amazonHref}
      target="_blank"
      rel="sponsored noopener"
      data-affiliate-kind="search"
      data-affiliate-placement="get_the_part"
      data-affiliate-part={part}
      data-affiliate-brand={brand}
    >
      Check on Amazon
    </a>
  </div>
  <p class="pc-note">
    Match your model and serial number before ordering.{pro && " Have a licensed tech install it."}
  </p>
</aside>

<style>
  .part-callout {
    margin: 2rem 0 0;
    padding: 1rem 1.1rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .pc-label {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--foreground) 58%, transparent);
  }
  .pc-part {
    margin: 0.3rem 0 0.85rem;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--brand);
  }
  /* Pulls up tight under the part name when a price is known. */
  .pc-price {
    margin: -0.6rem 0 0.85rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--foreground) 62%, transparent);
  }
  .pc-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.1rem;
  }
  .pc-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.7rem 1.2rem;
    border-radius: 9px;
    text-decoration: none;
    min-height: 44px;
    line-height: 1;
  }
  .pc-primary:hover {
    background: color-mix(in srgb, var(--accent) 88%, var(--foreground));
  }
  .pc-secondary {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--brand);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--brand) 35%, transparent);
    padding: 0.3rem 0;
  }
  .pc-secondary:hover { border-bottom-color: var(--brand); }
  .pc-note {
    margin: 0.7rem 0 0;
    font-size: 0.74rem;
    color: color-mix(in srgb, var(--foreground) 62%, transparent);
  }
  .pc-primary:focus-visible,
  .pc-secondary:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
</style>
