---
interface Props {
  description: string;
  title?: string;
}
const { description } = Astro.props;
---

<div class="quick-answer-box">
  <div class="quick-answer-label">⚡ Quick Answer</div>
  <p class="quick-answer-text">{description}</p>
  <div class="quick-answer-buttons">
    <a href="#step-by-step-fix" class="qa-btn qa-btn-primary" id="qa-fix-btn">Jump to Fix →</a>
    <a href="#parts-that-may-need-replacement" class="qa-btn qa-btn-secondary" id="qa-parts-btn">View Parts →</a>
  </div>
</div>

<script is:inline>
  // Find the correct anchor IDs on this page and update button hrefs
  document.addEventListener('DOMContentLoaded', function() {
    // Fix: step-by-step section — try multiple possible IDs
    var fixBtn = document.getElementById('qa-fix-btn');
    if (fixBtn) {
      var fixAnchors = ['step-by-step-fix', 'step-by-step', 'fix'];
      for (var i = 0; i < fixAnchors.length; i++) {
        if (document.getElementById(fixAnchors[i])) {
          fixBtn.href = '#' + fixAnchors[i];
          break;
        }
      }
    }
    // Parts: try multiple possible IDs
    var partsBtn = document.getElementById('qa-parts-btn');
    if (partsBtn) {
      var partsAnchors = ['parts-that-may-need-replacement', 'parts-often-needed', 'parts-and-tools-often-needed', 'parts-commonly-needed', 'parts-you-may-need', 'parts-to-have-ready', 'parts'];
      for (var j = 0; j < partsAnchors.length; j++) {
        if (document.getElementById(partsAnchors[j])) {
          partsBtn.href = '#' + partsAnchors[j];
          break;
        }
      }
    }
  });
</script>

<style>
  .quick-answer-box {
    background: #fff8e1;
    border: 2px solid #f59e0b;
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
    margin-top: 0.5rem;
  }
  .quick-answer-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #92400e;
    margin-bottom: 0.5rem;
  }
  .quick-answer-text {
    font-size: 1rem;
    color: #1c1917;
    margin: 0 0 1rem 0;
    line-height: 1.6;
  }
  .quick-answer-buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .qa-btn {
    display: inline-block;
    padding: 0.5rem 1.1rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .qa-btn:hover { opacity: 0.85; }
  .qa-btn-primary {
    background: #92400e;
    color: #fff;
  }
  .qa-btn-secondary {
    background: #f5f5f5;
    color: #44403c;
    border: 1px solid #d6d3d1;
  }
</style>
