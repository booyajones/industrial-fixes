---
import { getCollection, type CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";

interface Props {
  currentSlug: string;
  tags: string[];
  // Optional: pass the posts array down from the parent page so we don't
  // re-load the entire blog collection 1,148 times during build. Falls back
  // to a fresh getCollection() call for backward compatibility.
  posts?: CollectionEntry<"blog">[];
}

const { currentSlug, tags, posts } = Astro.props;

const allPosts = posts ?? (await getCollection("blog"));

// Tags shared by nearly every page carry no topical signal, so they must not
// drive relatedness. Matching on "appliance" alone is why a dryer page used to
// surface random microwaves. Score by MEANINGFUL shared tags only (brand +
// appliance type), require a real overlap, and drop drafts (they 404).
const UBIQUITOUS = new Set(["appliance", "model", "gas", "diy", "error-code"]);
const meaningful = (t: string[]) =>
  t.map(x => x.toLowerCase()).filter(x => !UBIQUITOUS.has(x));
const myTags = new Set(meaningful(tags));

const related = allPosts
  .filter(post => post.id !== currentSlug && !post.data.draft)
  .map(post => {
    const overlap = meaningful(post.data.tags).filter(t => myTags.has(t)).length;
    return { post, overlap };
  })
  .filter(r => r.overlap > 0)
  .sort(
    (a, b) =>
      b.overlap - a.overlap ||
      new Date(b.post.data.pubDatetime).getTime() -
        new Date(a.post.data.pubDatetime).getTime()
  )
  .slice(0, 4)
  .map(r => r.post);
---

{related.length > 0 && (
  <section class="related-posts-section">
    <h2 class="related-posts-heading">Related Fix Guides</h2>
    <div class="related-posts-grid">
      {related.map(post => (
        <a
          href={getPath(post.id, post.filePath)}
          class="related-post-card"
        >
          <div class="related-post-title">{post.data.title}</div>
          {post.data.description && (
            <p class="related-post-desc">{post.data.description}</p>
          )}
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-posts-section {
    margin-top: 2rem;
    margin-bottom: 1.5rem;
  }
  .related-posts-heading {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: inherit;
  }
  .related-posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
  }
  .related-post-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.85rem 1rem;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    text-decoration: none;
    background: #fafafa;
    transition: border-color 0.15s, background 0.15s;
  }
  .related-post-card:hover {
    border-color: #d97706;
    background: #fffbf0;
  }
  .related-post-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #1c1917;
    line-height: 1.4;
  }
  .related-post-desc {
    font-size: 0.775rem;
    color: #78716c;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
