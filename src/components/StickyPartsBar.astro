---
// Sticky mobile "get the part" bar. The reader has scrolled into the fix, so
// buying intent peaks. Appears only after they scroll past the diagnostic
// (earned, not begged), mobile only, routes to the consumer parts leader
// (RepairClinic) via Skimlinks (no noskim, so it is monetized). One clear CTA.
import { pickMerchant } from "@/utils/partMerchant";
interface Props {
  query: string;
  part?: string;
  brand?: string;
  tags?: readonly string[];
}
const { query, part = "", brand = "", tags = [] } = Astro.props;
// Route to the merchant that stocks this equipment class' parts (industrial ->
// Grainger, consumer -> RepairClinic). All Skimlinks-monetized.
const rcUrl = pickMerchant(tags).url(query);
// Assert the actual part, not a vague "the part you need". Truncate long part
// names so the bar stays one line on a phone.
const partLabel = part && part.length > 38 ? part.slice(0, 36).trimEnd() + "…" : part;
---

<div id="sticky-parts" class="sticky-parts" aria-hidden="true" data-pagefind-ignore>
  <div class="sp-inner">
    <span class="sp-text">{partLabel || "The exact part for this fix"}</span>
    <a
      class="sp-cta"
      href={rcUrl}
      target="_blank"
      rel="sponsored noopener"
      data-affiliate-network="skimlinks"
      data-affiliate-kind="parts-specialist"
      data-affiliate-placement="sticky_mobile"
      data-affiliate-brand={brand}
    >
      See prices
      <span aria-hidden="true">→</span>
    </a>
  </div>
</div>

<script is:inline>
  (function () {
    // Singleton listeners on window/document (they survive ClientRouter SPA
    // swaps), re-resolving the CURRENT bar node on every call — a captured
    // reference would go stale after the first astro:page-load and the bar
    // would never appear again (plus --sticky-parts-h would track a detached
    // node, breaking the ChatWidget FAB offset).
    var shown = false;
    function bar() {
      return document.getElementById("sticky-parts");
    }
    function apply(past) {
      shown = past;
      var b = bar();
      // Publish the bar's height as a CSS var so fixed elements that share the
      // bottom edge (the ChatWidget FAB) can shift up out of the collision.
      // offsetHeight is 0 when the bar is display:none (>=640px), so desktop
      // never shifts.
      document.documentElement.style.setProperty(
        "--sticky-parts-h",
        past && b ? b.offsetHeight + "px" : "0px"
      );
      if (!b) return;
      b.classList.toggle("visible", past);
      b.setAttribute("aria-hidden", past ? "false" : "true");
    }
    function onScroll() {
      var y = window.scrollY || document.documentElement.scrollTop;
      var past = y > 640;
      if (past !== shown) apply(past);
    }
    if (!window._ecfStickyBound) {
      window._ecfStickyBound = true;
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", function () { apply(shown); }, { passive: true });
      // SPA navigation: reset the var/state for the fresh page (which may have
      // no bar at all), then evaluate the new scroll position.
      document.addEventListener("astro:page-load", function () {
        apply(false);
        onScroll();
      });
    }
    onScroll();
  })();
</script>

<style>
  /* Mobile only. Hidden off-screen until the reader scrolls into the fix.
     visibility:hidden while off-screen so keyboard focus can never land on the
     invisible CTA (a11y); the visibility flip is delayed until the slide-out
     transition ends, and removed instantly on show. */
  .sticky-parts {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 45;
    transform: translateY(115%);
    visibility: hidden;
    transition: transform 0.25s ease, visibility 0s linear 0.25s;
    background: var(--brand);
    border-top: 2px solid var(--accent);
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.18);
  }
  .sticky-parts.visible {
    transform: translateY(0);
    visibility: visible;
    transition: transform 0.25s ease;
  }
  @media (min-width: 640px) {
    .sticky-parts {
      display: none;
    }
  }
  .sp-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    max-width: 48rem;
    margin: 0 auto;
    padding: 0.6rem 0.9rem calc(0.6rem + env(safe-area-inset-bottom));
  }
  .sp-text {
    color: var(--brand-contrast);
    font-weight: 600;
    font-size: 0.88rem;
    line-height: 1.2;
  }
  .sp-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.55rem 0.95rem;
    border-radius: 8px;
    text-decoration: none;
    white-space: nowrap;
  }
  .sp-cta:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
</style>
