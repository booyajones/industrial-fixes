---
// PartsSpecialist — a compact "Shop the replacement part" card that points the
// reader to a category-appropriate parts specialist (RepairClinic, SupplyHouse,
// Parts Town, Grainger). The reader has just diagnosed the fault; this is where
// buying intent peaks and parts specialists convert + pay better than a general
// store.
//
// MONETIZATION: these links are deliberately WITHOUT class="noskim" so the
// site-wide Skimlinks script (publisher 303448X1791493) rewrites them at click
// time. No per-merchant signup or affiliate params needed — Skimlinks covers
// repairclinic.com, supplyhouse.com, partstown.com, grainger.com and ~48k more.
// (Amazon links DO carry noskim elsewhere so they stay 100% Associates.)

interface Props {
  tags?: readonly string[];
  query: string;
}

const { tags = [], query } = Astro.props;

// A specialist: how to build its search URL + the label/copy the reader sees.
interface Specialist {
  name: string;
  url: (q: string) => string;
}

const REPAIR_CLINIC: Specialist = {
  name: "RepairClinic",
  url: q => `https://www.repairclinic.com/Shop-For-Parts?query=${encodeURIComponent(q)}`,
};
const SUPPLY_HOUSE: Specialist = {
  name: "SupplyHouse",
  url: q => `https://www.supplyhouse.com/sh/control/search/_/Ntt=${encodeURIComponent(q)}`,
};
const PARTS_TOWN: Specialist = {
  name: "Parts Town",
  url: q => `https://www.partstown.com/search?q=${encodeURIComponent(q)}`,
};
const GRAINGER: Specialist = {
  name: "Grainger",
  url: q => `https://www.grainger.com/search?searchQuery=${encodeURIComponent(q)}`,
};
const PART_SELECT: Specialist = {
  name: "PartSelect",
  url: q => `https://www.partselect.com/Search.aspx?SearchTerm=${encodeURIComponent(q)}`,
};

// Category -> specialist(s). Chosen by the FIRST tag (case-insensitive) that
// matches a rule below. Broad categories (HVAC etc.) get a second specialist
// so the reader can compare, but never more than 2.
interface Rule {
  match: string[];
  specialists: Specialist[];
}

const RULES: Rule[] = [
  // Residential kitchen/laundry appliances: RepairClinic + PartSelect are the
  // consumer appliance-parts leaders (both monetized by Skimlinks). Checked first
  // so a washer/dryer/fridge routes to consumer parts, not HVAC/industrial.
  { match: ["washer", "dryer", "dishwasher", "refrigerator", "oven", "range", "cooktop", "microwave", "appliance"], specialists: [REPAIR_CLINIC, PART_SELECT] },
  // Commercial refrigeration / ice machines: Parts Town is the OEM-parts leader,
  // RepairClinic as a broad-coverage backup. (Checked before HVAC so an article
  // tagged both "commercial-refrigeration" + "refrigeration" routes correctly.)
  { match: ["commercial-refrigeration", "ice-machine"], specialists: [PARTS_TOWN, REPAIR_CLINIC] },
  // Boiler / water-heater / plumbing: SupplyHouse is the specialist; RepairClinic backs it up.
  { match: ["boiler", "water-heater", "tankless", "plumbing"], specialists: [SUPPLY_HOUSE, REPAIR_CLINIC] },
  // Industrial controls / drives / compressors: Grainger.
  { match: ["vfd", "cnc", "plc", "industrial-controls", "compressor", "drive", "inverter"], specialists: [GRAINGER] },
  // HVAC family: RepairClinic primary + SupplyHouse for HVAC parts.
  { match: ["hvac", "furnace", "heat-pump", "mini-split", "refrigeration", "ac", "thermostat"], specialists: [REPAIR_CLINIC, SUPPLY_HOUSE] },
];

const lowerTags = tags.map(t => t.toLowerCase());

// Pick by the FIRST tag that matches any rule (preserves tag priority/order).
function pickSpecialists(): Specialist[] {
  for (const tag of lowerTags) {
    const rule = RULES.find(r => r.match.includes(tag));
    if (rule) return rule.specialists;
  }
  // Fallback -> RepairClinic (broadest consumer coverage).
  return [REPAIR_CLINIC];
}

const specialists = pickSpecialists().slice(0, 2);

// data-affiliate-brand carries the first tag for click-attribution parity with
// the other affiliate surfaces.
const brand = tags[0] ?? "";
---

<aside class="parts-specialist" aria-label="Shop the replacement part">
  <div class="ps-head">
    <span class="ps-icon" aria-hidden="true">🛒</span>
    <span class="ps-title">Shop the replacement part</span>
  </div>
  <div class="ps-links">
    {
      specialists.map(s => (
        <a
          class="ps-link"
          href={s.url(query)}
          target="_blank"
          rel="sponsored noopener"
          data-affiliate-network="skimlinks"
          data-affiliate-kind="parts-specialist"
          data-affiliate-placement="parts_specialist"
          data-affiliate-brand={brand}
        >
          Find it at {s.name}
          <span class="ps-arrow" aria-hidden="true">→</span>
        </a>
      ))
    }
  </div>
  <p class="ps-note">Verify the part fits your exact model before buying.</p>
</aside>

<style>
  .parts-specialist {
    margin: 2rem 0 0;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 6px;
    background: color-mix(in srgb, var(--muted) 45%, transparent);
  }
  .ps-head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.6rem;
  }
  .ps-icon {
    font-size: 0.95rem;
    line-height: 1;
  }
  .ps-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--foreground);
  }
  .ps-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  /* Bold accent-bordered chips. The label is --foreground (AA-safe on the
     panel in both themes); the accent shows as border + arrow + hover fill,
     so we never rely on accent-on-white body text for contrast. */
  .ps-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--accent);
    border-radius: 6px;
    background: var(--background);
    color: var(--foreground);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.15;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .ps-arrow {
    color: var(--accent);
    transition: color 0.15s ease;
  }
  .ps-link:hover,
  .ps-link:focus-visible {
    background: var(--accent);
    color: #fff;
  }
  .ps-link:hover .ps-arrow,
  .ps-link:focus-visible .ps-arrow {
    color: #fff;
  }
  .ps-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .ps-note {
    margin: 0.55rem 0 0;
    font-size: 0.72rem;
    /* 68% foreground mix keeps the caption quiet but AA-legible on the panel. */
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
  }
</style>
