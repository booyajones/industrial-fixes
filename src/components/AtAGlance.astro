---
import { getTriage } from "@/utils/triage";

interface Props {
  tags?: readonly string[];
}

const { tags } = Astro.props;
const { difficulty, time, tools } = getTriage(tags);

// Amazon Associates tag — keep in sync with AmazonPartLink.astro / parts.json.
const TAG = "errorcodefixes-20";

// Allowlist of genuinely buyable, repair-relevant tools. Anything not on this
// list (PPE, service manual) renders as plain text — never linked. Matching is
// case-insensitive and tolerant of plural / wording variants ("gauges",
// "gauge set", "refrigerant gauges").
const BUYABLE: { test: RegExp; query: string }[] = [
  { test: /\bmultimeter\b/i, query: "multimeter" },
  { test: /\bmanometer\b/i, query: "manometer" },
  { test: /\bcombustion analyzer\b/i, query: "combustion analyzer" },
  { test: /\b(?:refrigerant )?gauges?(?: set)?\b/i, query: "refrigerant gauge set" },
  { test: /\bthermometer\b/i, query: "thermometer" },
  { test: /\bESD strap\b/i, query: "ESD strap" },
  { test: /\bscrewdrivers?\b/i, query: "screwdriver set" },
  { test: /\bmegohmmeter\b/i, query: "megohmmeter" },
  { test: /\bclamp meter\b/i, query: "clamp meter" },
];

function buyableQuery(tool: string): string | null {
  const match = BUYABLE.find(b => b.test.test(tool));
  return match ? match.query : null;
}

// Build the affiliate search URL for a buyable tool. Format per shared contract:
//   https://www.amazon.com/s?k=<urlenc>&tag=errorcodefixes-20
function amazonSearch(query: string): string {
  return `https://www.amazon.com/s?k=${encodeURIComponent(query)}&tag=${TAG}`;
}

// Precompute render model so the template stays clean and the JSON-LD ItemList
// uses the exact same tool names shown to the reader.
const toolItems = tools.map(tool => {
  const query = buyableQuery(tool);
  return {
    name: tool,
    href: query ? amazonSearch(query) : null,
  };
});

// Schema-safe ItemList: tool NAMES only. No price, no Offer, no availability —
// avoids Product/Offer compliance exposure (council guidance).
const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Tools for this repair",
  itemListElement: toolItems.map((t, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: t.name,
  })),
};
---

<div class="at-a-glance" aria-label="At a glance: repair triage">
  <div class="ataglance-item">
    <svg
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 20V10" />
      <path d="M18 20V4" />
      <path d="M6 20v-4" />
    </svg>
    <span class="ataglance-label">Difficulty</span>
    <span class="ataglance-value">{difficulty}</span>
  </div>
  <div class="ataglance-item">
    <svg
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="10" />
      <polyline points="12 6 12 12 16 14" />
    </svg>
    <span class="ataglance-label">Est. time</span>
    <span class="ataglance-value">{time}</span>
  </div>
  <div class="ataglance-item">
    <svg
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4l-6 6a2 2 0 1 0 3 3l6-6a4 4 0 0 0 5.4-5.4l-2.6 2.6-2-2 2.6-2.6z" />
    </svg>
    <span class="ataglance-label">Tools</span>
    <span class="ataglance-value ataglance-tools">
      {
        toolItems.map((t, i) => (
          <>
            {t.href ? (
              <a
                class="noskim ataglance-tool-link"
                href={t.href}
                target="_blank"
                rel="sponsored noopener"
                data-affiliate-brand=""
                data-affiliate-kind="tool"
                data-affiliate-part={t.name}
                data-affiliate-placement="at_a_glance"
              >
                {t.name}
              </a>
            ) : (
              <span class="ataglance-tool-plain">{t.name}</span>
            )}
            {i < toolItems.length - 1 ? <span class="ataglance-tool-sep">, </span> : null}
          </>
        ))
      }
    </span>
  </div>
</div>

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(itemListJsonLd)}
/>

<style>
  .at-a-glance {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    align-items: center;
    padding: 0.7rem 1rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 6px;
    background: color-mix(in srgb, var(--muted) 45%, transparent);
    font-size: 0.8rem;
  }
  .ataglance-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
  }
  .ataglance-item svg {
    flex: none;
    color: var(--accent);
  }
  .ataglance-label {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.68rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
  }
  .ataglance-value {
    font-weight: 600;
    color: var(--foreground);
  }
  /* The tool list sits ABOVE the QuickAnswer answer, so links must be quiet:
     full-contrast foreground text with a subtle underline, never a button or
     accent fill. Resting color is --foreground (AA-safe on the panel for both
     themes); accent appears only on hover/focus as an affordance. */
  .ataglance-tool-link {
    color: var(--foreground);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--foreground) 35%, transparent);
    text-underline-offset: 0.15em;
    transition: text-decoration-color 0.15s ease, color 0.15s ease;
  }
  .ataglance-tool-link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
  .ataglance-tool-plain {
    font-weight: 600;
    color: var(--foreground);
  }
  /* Commas join the list as plain punctuation, not links. */
  .ataglance-tool-sep {
    font-weight: 600;
    color: var(--foreground);
  }
  /* On narrow screens each item gets its own row so long tool lists stay
     readable instead of crowding the difficulty/time chips. */
  @media (max-width: 30rem) {
    .at-a-glance {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
