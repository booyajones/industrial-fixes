---
interface Props {
  equipment?: string;
}
const { equipment = "HVAC" } = Astro.props;
---

<div class="contractor-cta">
  <div class="contractor-cta-content">
    <strong>🔧 Need a professional?</strong>
    <span>Get free quotes from certified {equipment} contractors near you.</span>
  </div>
  <a
    href="https://www.angi.com/companylist/hvac-contractors.htm"
    target="_blank"
    rel="noopener sponsored"
    class="contractor-cta-btn"
  >
    Get Free Quotes →
  </a>
</div>

<style>
  .contractor-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    background: #f0f9ff;
    border: 1px solid #bae6fd;
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
  }
  .contractor-cta-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.9rem;
    color: #1c1917;
  }
  .contractor-cta-btn {
    background: #0369a1;
    color: white;
    border-radius: 6px;
    padding: 0.5rem 1.1rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .contractor-cta-btn:hover { background: #075985; }
</style>
