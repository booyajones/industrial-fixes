---
import { equipmentCategories } from "@/data/equipmentCategories";

interface Props {
  // First tag from the post — used to pick the right category-specific PDF
  // and headline. Falls back to the master "industrial" cheat sheet if the
  // tag doesn't map to any equipment category.
  brand?: string;
  // Or pass an explicit category slug ("hvac" | "cnc" | "refrigeration" |
  // "boilers"). Wins over `brand` when both are set.
  category?: string;
}

const { brand, category } = Astro.props;

function resolveCategory(): { slug: string; name: string } {
  if (category) {
    const hit = equipmentCategories.find(c => c.slug === category);
    if (hit) return { slug: hit.slug, name: hit.name };
  }
  if (brand) {
    const lower = brand.toLowerCase();
    const hit = equipmentCategories.find(c => c.tags.includes(lower));
    if (hit) return { slug: hit.slug, name: hit.name };
  }
  return { slug: "industrial", name: "Industrial" };
}

const cat = resolveCategory();
const headline =
  cat.slug === "industrial"
    ? "Get the complete error code reference"
    : `Get the ${cat.name} error code cheat sheet`;
---

<div class="email-capture-box">
  <div class="email-capture-inner">
    <div class="email-capture-text">
      <strong>{headline}</strong>
      <span> — free PDF with all common codes, causes, and fixes.</span>
    </div>
    <form
      class="email-capture-form"
      action="/api/subscribe"
      method="POST"
      data-ecf-capture
    >
      <input type="hidden" name="ecf_cat" value={cat.slug} />
      <input
        type="email"
        name="email"
        placeholder="your@email.com"
        required
        class="email-input"
      />
      <button type="submit" class="email-submit">Get Free PDF</button>
    </form>
    <p class="email-capture-error" role="alert" hidden>
      Something went wrong sending this — email us directly at
      <a href="mailto:info@errorcodefixes.com">info@errorcodefixes.com</a>.
    </p>
  </div>
</div>

<script is:inline>
  // Progressive enhancement: the plain form POSTs to /api/subscribe (a
  // Cloudflare Pages Function that adds the email to our Resend audience and
  // 303-redirects to /thanks/) as a no-JS fallback. When JS is available we
  // submit via fetch and only fire the GA4 lead event + redirect on a
  // CONFIRMED-OK response — a blind redirect on failure would silently drop
  // the signup while showing the thank-you page. On failure: inline error.
  (function () {
    function bind() {
      document.querySelectorAll('form[data-ecf-capture]').forEach(function (form) {
        if (form._ecfBound) return;
        form._ecfBound = true;
        form.addEventListener('submit', function (e) {
          var input = form.querySelector('input[type=email]');
          if (!input || !input.value) return; // let HTML validation handle empty
          e.preventDefault();
          var catEl = form.querySelector('input[name=ecf_cat]');
          var cat = catEl ? catEl.value : 'industrial';
          var btn = form.querySelector('button[type=submit]');
          var err = form.parentElement ? form.parentElement.querySelector('.email-capture-error') : null;
          if (err) err.hidden = true;
          if (btn) btn.disabled = true;
          fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ email: input.value, ecf_cat: cat }),
          }).then(function (resp) {
            return resp.json().catch(function () { return {}; }).then(function (d) {
              return resp.ok && d.ok === true;
            });
          }).catch(function () {
            return false;
          }).then(function (ok) {
            if (ok) {
              if (typeof gtag === 'function') {
                gtag('event', 'lead_signup', { method: 'email_capture', category: cat });
              }
              var redirect = '/thanks/' + (cat && cat !== 'industrial' ? '?cat=' + encodeURIComponent(cat) : '');
              window.location.href = redirect;
            } else {
              if (btn) btn.disabled = false;
              if (err) err.hidden = false;
            }
          });
        });
      });
    }
    bind();
    document.addEventListener('astro:page-load', bind);
  })();
</script>

<style>
  /* Token colors only, so the box holds up in both themes (the old hardcoded
     amber gradient glowed light-mode colors inside dark mode). */
  .email-capture-box {
    background: var(--muted);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
  }
  .email-capture-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .email-capture-text {
    font-size: 0.95rem;
    color: var(--foreground);
    line-height: 1.5;
  }
  .email-capture-form {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .email-input {
    flex: 1;
    min-width: 200px;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.875rem;
    background: var(--surface);
    color: var(--foreground);
  }
  .email-submit {
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 6px;
    padding: 0.5rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }
  .email-submit:hover {
    background: color-mix(in srgb, var(--accent) 88%, var(--foreground));
  }
  .email-submit:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .email-capture-error {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--danger);
  }
  .email-capture-error a {
    color: var(--danger);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
