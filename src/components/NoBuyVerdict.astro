---
// NoBuyVerdict — the single biggest conversion + moat lever (total-review DO-NOW
// #2). Renders ABOVE the fold on every code page that carries a money_part.
//
// The thesis: an AI Overview will happily answer "what is the 3C code" and eat
// the click. What it will NOT do is make the judgment call — "you probably don't
// need to buy the $90 pump yet, ~70% of these are a $0 filter clog, do these two
// checks first." That judgment call is the one click worth fighting for, and it
// doubles as the honesty moat AND a buyer pre-qualifier: the reader who reaches
// the part CTA (now BELOW the free-fix gate) has already ruled out the cheap
// fixes, so they convert harder.
//
// Green, not orange: this card signals "you might save money" — the opposite of
// the orange PartCallout buy button below the gate. The escape hatch
// (#get-the-part) lets a reader who already did the checks jump straight to it.
interface Props {
  cause?: string;        // most_likely_cause
  part: string;          // money_part — the part they're tempted to buy
  partPrice?: string;    // e.g. "$45–70" — typical street price, rendered only when known
  noBuyPct?: string;     // e.g. "70%" — share that are a $0/cheap fix; rendered only when grounded
  freeChecks?: string[]; // 2–3 free checks to do first; falls back to "the steps below" when absent
  pro?: boolean;
  code?: string;         // the error code token, for natural phrasing
  diyOrPro?: string;     // "diy" | "pro" — renders the difficulty badge
}
const { cause, part, partPrice, noBuyPct, freeChecks = [], pro = false, code, diyOrPro } = Astro.props;
const codeRef = code ? `${code} codes` : "these codes";
const checks = freeChecks.filter(c => c && c.trim()).slice(0, 3);
const badge = diyOrPro === "diy" ? "DIY-friendly" : diyOrPro === "pro" ? "Pro repair" : null;

// SAFETY + HONESTY (storm review action #1): the "most are a cheap $0 fix" claim
// is OPT-IN, never the default. Asserting it on a sealed-system / refrigerant /
// VFD / igniter fault is both false and unsafe, and ~1,847 money pages carry no
// diy_or_pro to judge from. So we only assert "cheap fix" with positive, safe
// signal; everything else gets a neutral "confirm before you buy" lead that is
// true for every code, and known-dangerous classes get an explicit pro lead.
const _p = (part || "").toLowerCase();
// Classes where the fault is dangerous / not a homeowner cheap fix -> pro lead.
const DANGER = /compressor|refrigerant|sealed system|sealed-system|\binverter\b|\bipm\b|\bsto\b|gas[\s-]?valve|\bvfd\b|servo|\bstator\b|high[\s-]?voltage|\bacs\d|powerflex/;
// Classes where the named part is usually the real failure, so "probably not the
// part / it's a cheap fix" would mislead -> neutral lead (still anti-misdiagnosis).
const PART_IS_FAILURE = /ignit|heating element|bake element|broil element|thermal fuse|glow|flame sensor|control board|main board/;
const isDanger = pro || DANGER.test(_p);
// Assert cheap-fix only when grounded (no_buy_pct from the honesty judge) OR an
// explicit DIY label, AND the part isn't a danger/“part-is-the-failure” class.
const assertCheap = !isDanger && !PART_IS_FAILURE.test(_p) && (Boolean(noBuyPct) || diyOrPro === "diy");
const causeFrag = cause ? cause.replace(/\.$/, "").toLowerCase() : "";
---

<aside class="nbv" data-pagefind-ignore aria-label="Before you buy a part">
  <div class="nbv-head">
    <svg class="nbv-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8"/>
    </svg>
    <span class="nbv-label">Before you buy a part</span>
    {badge && <span class={`nbv-badge nbv-${diyOrPro}`}>{badge}</span>}
  </div>

  {isDanger ? (
    <p class="nbv-lead">
      {code ? `${code} ` : "This code "}usually needs a proper diagnosis, and the wrong part will not clear it.
      Confirm the cause{causeFrag && <> (often <strong>{causeFrag}</strong>)</>} before you buy a {part}.
    </p>
  ) : assertCheap ? (
    <p class="nbv-lead">
      {noBuyPct
        ? <>About <strong>{noBuyPct}</strong> of {codeRef} are a $0 to cheap fix, not a failed part.</>
        : <>Most {codeRef} are a cheap or $0 fix, not a failed part.</>}
      {causeFrag && <> The usual culprit is <strong>{causeFrag}</strong>.</>}
      {" "}Rule that out before you spend anything.
    </p>
  ) : (
    <p class="nbv-lead">
      Confirm it is actually the cause before you buy a {part}.
      {code ? ` ${code} ` : " This code "}can have more than one, and the wrong part will not clear it.
      {causeFrag && <> The usual culprit is <strong>{causeFrag}</strong>.</>}
      {" "}Check the basics first.
    </p>
  )}

  {checks.length > 0 && (
    <ol class="nbv-checks">
      {checks.map(c => <li>{c.replace(/\.$/, "")}</li>)}
    </ol>
  )}

  <p class="nbv-fork">
    {partPrice && <>A new {part} runs about <strong>{partPrice}</strong>. </>}
    {assertCheap
      ? (checks.length > 0
          ? "The checks above cost nothing and clear most of these. Do them first."
          : "Work the free checks in the steps below before you order anything.")
      : "Confirm the diagnosis first — the wrong part will not clear the code."}
  </p>

  <a class="nbv-skip" href="#get-the-part">
    Already ruled those out? See the exact part
    <span aria-hidden="true">&rarr;</span>
  </a>
</aside>

<style>
  /* Green = "you might not need to buy." Deliberately the inverse of the orange
     PartCallout buy button below the gate. --safe is the site's green token. */
  .nbv {
    margin: 0 0 1.5rem;
    padding: 1rem 1.1rem 1.05rem;
    background: color-mix(in srgb, var(--safe) 7%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--safe) 28%, var(--border));
    border-left: 4px solid var(--safe);
    border-radius: 12px;
  }
  .nbv-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.5rem;
    color: var(--safe);
  }
  .nbv-label {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .nbv-badge {
    margin-left: auto;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .nbv-diy {
    color: var(--safe);
    background: color-mix(in srgb, var(--safe) 18%, transparent);
  }
  .nbv-pro {
    color: var(--danger);
    background: color-mix(in srgb, var(--danger) 16%, transparent);
  }
  .nbv-lead {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--foreground);
  }
  .nbv-lead strong { font-weight: 700; }
  .nbv-checks {
    margin: 0.7rem 0 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .nbv-checks li {
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--foreground);
  }
  .nbv-fork {
    margin: 0.7rem 0 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: color-mix(in srgb, var(--foreground) 82%, transparent);
  }
  .nbv-fork strong { color: var(--foreground); font-weight: 700; }
  .nbv-skip {
    display: inline-block;
    margin-top: 0.8rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--brand);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--brand) 35%, transparent);
    padding-bottom: 1px;
  }
  .nbv-skip:hover,
  .nbv-skip:focus-visible { border-bottom-color: var(--brand); }
  .nbv-skip:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>
